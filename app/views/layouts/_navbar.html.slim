nav.navbar.navbar-expand-lg
  .container-fluid
    = link_to "ПАДЕЛ Пульт", root_path, class: "navbar-brand fw-semibold"

    button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation"
      span.navbar-toggler-icon

    #navbarCollapse.collapse.navbar-collapse data-navbar-target="menu"
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        - if user_signed_in?
          li.nav-item
            = link_to t('layouts.navbar.leagues'), leagues_path, class: "nav-link #{request.path.start_with?('/leagues') ? 'active' : ''}", aria: { current: (request.path.start_with?('/leagues') ? 'page' : nil) }
          li.nav-item
            = link_to t('layouts.navbar.tournaments'), tournaments_path, class: "nav-link #{request.path.start_with?('/tournaments') ? 'active' : ''}", aria: { current: (request.path.start_with?('/tournaments') ? 'page' : nil) }
          li.nav-item
            = link_to t('layouts.navbar.players'), users_path, class: "nav-link #{request.path.start_with?('/users') ? 'active' : ''}", aria: { current: (request.path.start_with?('/users') ? 'page' : nil) }

      - if user_signed_in?
        ul.navbar-nav.ms-auto.align-items-center.gap-2
          li.nav-item.dropdown
            a.nav-link href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
              span.position-relative
                svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"
                  path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"
                - if @pending_invitations.any?
                  span.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger style="font-size:0.6rem;"
                    = @pending_invitations.size
            ul.dropdown-menu.dropdown-menu-end style="min-width:300px;"
              - if @pending_invitations.any?
                - @pending_invitations.each do |invitation|
                  li.px-3.py-2.border-bottom
                    .fw-semibold.small= invitation.league.name
                    .text-muted.small= t('layouts.navbar.invited_by', name: invitation.invited_by.full_name)
                    .d-flex.gap-2.mt-2
                      = button_to t('layouts.navbar.accept'), league_invitation_path(invitation), method: :patch, params: { status: "accepted" }, class: "btn btn-success btn-sm", form: { data: { turbo: false } }
                      = button_to t('layouts.navbar.dismiss'), league_invitation_path(invitation), method: :patch, params: { status: "dismissed" }, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo: false } }
              - else
                li.px-3.py-2.text-muted.small= t('layouts.navbar.no_invitations')
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
              .d-inline-flex.align-items-center.justify-content-center.rounded-circle style="width:32px;height:32px;background:var(--color-bg-surface);border:1px solid var(--color-border);font-size:0.75rem;font-weight:600;color:var(--color-text-muted);"
                = current_user.full_name.split.map(&:first).first(2).join.upcase
            ul.dropdown-menu.dropdown-menu-end
              li
                = link_to t('layouts.navbar.edit_account'), edit_user_registration_path, class: "dropdown-item"
              li
                hr.dropdown-divider
              li
                = button_to t('layouts.navbar.sign_out'), destroy_user_session_path, method: :delete, class: "dropdown-item text-danger border-0 bg-transparent w-100 text-start"
      - else
        ul.navbar-nav.ms-auto
          li.nav-item
            = link_to t('layouts.navbar.sign_in'), new_user_session_path, class: "nav-link"
          li.nav-item
            = link_to t('layouts.navbar.sign_up'), new_user_registration_path, class: "btn btn-primary btn-sm ms-2"
