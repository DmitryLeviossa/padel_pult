nav.navbar.navbar-expand-lg
  .container-fluid
    = link_to root_path, class: "navbar-brand fw-semibold d-flex align-items-center gap-2" do
      = image_tag "/icon.svg", width: 28, height: 28, alt: ""
      | ПАДЕЛ Пульт

    button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation"
      span.navbar-toggler-icon

    #navbarCollapse.collapse.navbar-collapse data-navbar-target="menu"
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        - if user_signed_in?
          li.nav-item
            = link_to leagues_path, class: "nav-link #{request.path.start_with?('/leagues') ? 'active' : ''}", aria: { current: (request.path.start_with?('/leagues') ? 'page' : nil) } do
              i.bi.bi-trophy.me-1
              | Лиги
          li.nav-item
            = link_to tournaments_path, class: "nav-link #{request.path.start_with?('/tournaments') ? 'active' : ''}", aria: { current: (request.path.start_with?('/tournaments') ? 'page' : nil) } do
              i.bi.bi-calendar-event.me-1
              | Турниры
          li.nav-item
            = link_to users_path, class: "nav-link #{request.path.start_with?('/users') ? 'active' : ''}", aria: { current: (request.path.start_with?('/users') ? 'page' : nil) } do
              i.bi.bi-people.me-1
              | Игроки
          li.nav-item
            = link_to clubs_path, class: "nav-link #{request.path.start_with?('/clubs') ? 'active' : ''}", aria: { current: (request.path.start_with?('/clubs') ? 'page' : nil) } do
              i.bi.bi-geo-alt.me-1
              | Клубы
          - if current_user.id == 1
            li.nav-item
              = link_to admin_leagues_path, class: "nav-link #{request.path.start_with?('/admin') ? 'active' : ''}", aria: { current: (request.path.start_with?('/admin') ? 'page' : nil) } do
                i.bi.bi-shield-lock.me-1
                | Админ

      - if user_signed_in?
        ul.navbar-nav.ms-auto.align-items-center.gap-2
          li.nav-item.dropdown
            a.nav-link href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
              span.position-relative
                svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"
                  path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"
                - if @unread_notifications.any?
                  span.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger style="font-size:0.6rem;"
                    = @unread_notifications.size
            ul.dropdown-menu.dropdown-menu-end style="min-width:300px;"
              - if @unread_notifications.any?
                - @unread_notifications.each do |notification|
                  li
                    = link_to visit_notification_path(notification), class: "dropdown-item py-2 text-wrap"
                      .small= notification.message
                      .text-muted style="font-size:0.7rem;"= l(notification.created_at, format: :short)
                li.px-3.py-2.border-top.text-end
                  = button_to "Отметить всё прочитанным", mark_all_read_notifications_path, method: :patch, class: "btn btn-link btn-sm p-0 text-muted border-0 bg-transparent", form: { data: { turbo: false } }
              - else
                li.px-3.py-2.text-muted.small Нет новых уведомлений
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
              .d-inline-flex.align-items-center.justify-content-center.rounded-circle style="width:32px;height:32px;background:var(--color-bg-surface);border:1px solid var(--color-border);font-size:0.75rem;font-weight:600;color:var(--color-text-muted);"
                = current_user.full_name.split.map(&:first).first(2).join.upcase
            ul.dropdown-menu.dropdown-menu-end
              li
                = link_to "Мой профиль", user_path(current_user), class: "dropdown-item"
              li
                = link_to "Редактировать аккаунт", edit_user_registration_path, class: "dropdown-item"
              li
                hr.dropdown-divider
              li
                = button_to "Выйти", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger border-0 bg-transparent w-100 text-start"
      - else
        ul.navbar-nav.ms-auto
          li.nav-item
            = link_to new_user_session_path, class: "nav-link" do
              i.bi.bi-box-arrow-in-right.me-1
              | Войти
          li.nav-item
            = link_to new_user_registration_path, class: "btn btn-primary btn-sm ms-2" do
              i.bi.bi-person-plus.me-1
              | Регистрация
