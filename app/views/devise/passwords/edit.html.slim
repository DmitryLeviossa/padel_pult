.container.py-4
  .row.justify-content-center
    .col-md-5
      .card
        .card-body.p-4
          h2.card-title.mb-4 Изменить пароль

          = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
            = render "devise/shared/error_messages", resource: resource
            = f.hidden_field :reset_password_token

            .mb-3
              = f.label :password, "Новый пароль", class: "form-label"
              - if @minimum_password_length
                small.text-muted.d-block.mb-1 Минимум #{@minimum_password_length} символов
              = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control"

            .mb-3
              = f.label :password_confirmation, "Подтвердите новый пароль", class: "form-label"
              = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control"

            = f.submit "Изменить пароль", class: "btn btn-primary w-100"

          hr.my-3
          .text-center.small
            = render "devise/shared/links"
