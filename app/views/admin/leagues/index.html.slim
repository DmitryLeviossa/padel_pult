- content_for :title, "Админ — Квоты лиг"

.container.py-4
  h1.mb-4 Квоты турниров по лигам

  .card
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead
            tr
              th #
              th Название
              th Владелец
              th.text-center style="width: 160px;" Квота турниров
          tbody
            - @leagues.each do |league|
              tr
                td.text-muted= league.id
                td= link_to league.name, league_path(league)
                td= league.owner.full_name
                td.text-center
                  = form_with url: admin_league_path(league), method: :patch,
                      data: { controller: "admin-quota", turbo: true } do |f|
                    = f.number_field :tournaments_quota,
                        value: league.tournaments_quota,
                        min: 1, max: 999,
                        class: "form-control form-control-sm text-center",
                        style: "width: 80px; display: inline-block;",
                        data: { action: "change->admin-quota#save", "admin-quota-target": "input" }
                    span.ms-2.text-success.d-none data-admin-quota-target="saved" ✓
