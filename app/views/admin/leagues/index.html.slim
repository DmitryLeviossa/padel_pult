- content_for :title, "Админ — Квоты лиг"

.container.py-4
  .d-flex.align-items-center.justify-content-between.mb-4
    h1.mb-0 Квоты турниров по лигам
    = link_to "/sidekiq", class: "btn btn-outline-secondary btn-sm", target: "_blank" do
      i.bi.bi-gear.me-1
      | Sidekiq

  .card
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead
            tr
              th #
              th Название
              th Владелец
              th.text-center Турниров
              th.text-center style="width: 160px;" Квота турниров
          tbody
            - @leagues.each do |league|
              tr
                td.text-muted= league.id
                td= link_to league.name, league_path(league)
                td= league.owner.full_name
                td.text-center= league.tournaments_count
                td.text-center
                  = form_with url: admin_league_path(league), method: :patch, scope: :league,
                      data: { controller: "admin-quota", turbo: true } do |f|
                    = f.number_field :tournaments_quota,
                        value: league.tournaments_quota,
                        min: 1, max: 999,
                        class: "form-control form-control-sm text-center",
                        style: "width: 80px; display: inline-block;",
                        data: { action: "change->admin-quota#save", "admin-quota-target": "input" }
                    span.ms-2.text-success.d-none data-admin-quota-target="saved" ✓

  h2.mt-5.mb-3 Пользователи (#{@users.count})
  .card
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead
            tr
              th #
              th Имя
              th Email
              th Пол
              th Зарегистрирован
          tbody
            - @users.each do |user|
              tr
                td.text-muted= user.id
                td= link_to user.full_name, user_path(user)
                td= user.email
                td= user.gender_male? ? "М" : "Ж"
                td= l(user.created_at, format: :short)
