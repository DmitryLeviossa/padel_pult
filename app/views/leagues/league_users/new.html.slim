.container.py-4
  .row.justify-content-center
    .col-md-6
      h1.mb-4 Добавить нового участника

      = form_with model: @user, url: league_league_users_path(@league), method: :post, data: { turbo: false } do |f|
        = render "devise/shared/error_messages", resource: @user

        .mb-3
          = f.label :first_name, "Имя", class: "form-label"
          = f.text_field :first_name, class: "form-control", autofocus: true

        .mb-3
          = f.label :last_name, "Фамилия", class: "form-label"
          = f.text_field :last_name, class: "form-control"

        .mb-3
          = f.label :gender, "Пол", class: "form-label"
          = f.select :gender, options_for_select(User.genders.keys.map { |g| [{ "male" => "Мужской", "female" => "Женский" }.fetch(g, g), g] }), { include_blank: "— Пол —" }, class: "form-select"

        .d-flex.gap-2
          = f.submit "Создать", class: "btn btn-primary"
          = link_to "Отмена", league_path(@league, anchor: "league-users"), class: "btn btn-outline-secondary"
