h1 New League

= form_with model: @league, class: "mt-4" do |f|
  .mb-3
    = f.label :name, class: "form-label"
    = f.text_field :name, class: "form-control", required: true
    - if @league.errors[:name].any?
      .text-danger.small= @league.errors[:name].first

  .mb-3
    = f.label :description, class: "form-label"
    = f.text_area :description, class: "form-control", rows: 4

  = f.submit "Create League", class: "btn btn-primary"
  = link_to "Cancel", leagues_path, class: "btn btn-secondary ms-2"
