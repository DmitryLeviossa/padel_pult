.container.py-4
  h1.mb-4 Редактировать лигу

  = form_with model: @league, class: "mt-4" do |f|
    .mb-3
      = f.label :name, "Название", class: "form-label"
      = f.text_field :name, class: "form-control", required: true
      - if @league.errors[:name].any?
        .text-danger.small= @league.errors[:name].first

    .mb-3
      = f.label :description, "Описание", class: "form-label"
      = f.text_area :description, class: "form-control", rows: 4

    .mb-3
      = f.label :logo, "Логотип", class: "form-label"
      - if @league.logo.attached?
        .mb-2
          = image_tag @league.logo, class: "rounded", style: "width: 80px; height: 80px; object-fit: cover;"
      = f.file_field :logo, class: "form-control", accept: "image/*"

    .mb-3
      = f.label :online_background, "Фон онлайн-страницы", class: "form-label"
      - if @league.online_background.attached?
        .mb-2
          = image_tag @league.online_background, class: "rounded", style: "width: 160px; height: 90px; object-fit: cover;"
      = f.file_field :online_background, class: "form-control", accept: "image/*"

    = f.submit "Сохранить", class: "btn btn-primary"
    = link_to "Отмена", @league, class: "btn btn-secondary ms-2"