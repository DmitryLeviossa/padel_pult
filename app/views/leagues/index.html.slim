.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0 Лиги
    = link_to "Новая лига", new_league_path, class: "btn btn-primary"

  ul.nav.nav-pills.mb-3
    li.nav-item
      = link_to "Мои лиги", leagues_path(q: params[:q]), class: "nav-link #{'active' if params[:filter] != 'all'}"
    li.nav-item
      = link_to "Все лиги", leagues_path(filter: 'all', q: params[:q]), class: "nav-link #{'active' if params[:filter] == 'all'}"

  = search_form_for @q, url: leagues_path, method: :get, html: { class: "mb-4", data: { auto_submit: "" } } do |f|
    - if params[:filter] == 'all'
      = hidden_field_tag :filter, params[:filter]
    .row.g-2.align-items-end
      .col-md-10
        label.form-label Название
        = f.search_field :name_cont, class: "form-control", placeholder: "Поиск по названию"
      .col-md-2
        = link_to "Сбросить", leagues_path(filter: params[:filter] == 'all' ? 'all' : nil), class: "btn btn-outline-secondary w-100"

  - if @leagues.any?
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
      - @leagues.each do |league|
        .col
          .card.card-hoverable.h-100
            - if league.logo.attached?
              = image_tag league.logo, class: "card-img-top", style: "object-fit: contain; background-color: #111827;"
            - else
              = image_tag "/default_league_logo.jpg", class: "card-img-top", style: "object-fit: contain; background-color: #111827;"
            .card-body
              .d-flex.align-items-start.gap-2.mb-1
                h5.card-title.mb-0= link_to league.name, league_path(league), class: "text-decoration-none stretched-link"
                - if user_signed_in? && league.owner_id == current_user.id
                  span.badge.bg-primary.flex-shrink-0 Владелец
              - if league.description.present?
                p.card-text.text-muted= league.description
            .card-footer.text-muted.small
              = "Создано #{ru_date(league.created_at.to_date)}"
  - else
    p.text-muted Лиг пока нет.
