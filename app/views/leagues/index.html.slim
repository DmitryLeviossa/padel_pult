.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0 Leagues
    = link_to "New League", new_league_path, class: "btn btn-primary"

  - if flash[:notice]
    .alert.alert-success= flash[:notice]

  - if @leagues.any?
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
      - @leagues.each do |league|
        .col
          .card.h-100.shadow-sm
            .card-body
              h5.card-title= link_to league.name, league_path(league), class: "text-decoration-none stretched-link"
              - if league.description.present?
                p.card-text.text-muted= league.description
            .card-footer.text-muted.small
              | Created #{league.created_at.strftime("%b %d, %Y")}
  - else
    p.text-muted No leagues yet.
