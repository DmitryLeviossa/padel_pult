.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    .d-flex.align-items-center.gap-3
      - if @league.logo.attached?
        = image_tag @league.logo, class: "rounded", style: "width: 64px; height: 64px; object-fit: cover;"
      h1.mb-0= @league.name
    .d-flex.gap-2
      - if @league.owner == current_user
        = link_to edit_league_path(@league), class: "btn btn-outline-primary btn-sm", data: { tooltip: "Редактировать" } do
          i.bi.bi-pencil-square
      - elsif @league.users.include?(current_user)
        = button_to leave_league_path(@league), method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Вы уверены, что хотите покинуть лигу?", tooltip: "Покинуть лигу" } do
          i.bi.bi-box-arrow-right
      - else
        = button_to join_league_path(@league), method: :post, class: "btn btn-primary btn-sm", data: { tooltip: "Вступить в лигу" } do
          i.bi.bi-person-plus
      = link_to leagues_path, class: "btn btn-outline-secondary btn-sm", data: { tooltip: "Все лиги" } do
        i.bi.bi-arrow-left

  - if @league.description.present?
    p.text-muted= @league.description

  p.text-muted.small= "Создано #{ru_date(@league.created_at.to_date)} пользователем #{@league.owner.email}"

  - members_tab_active = params[:q_members].present? || params[:members_status].present?

  ul.nav.nav-tabs.mt-4 role="tablist" data-controller="tabs"
    li.nav-item role="presentation"
      button.nav-link class=("active" unless members_tab_active) type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tournaments" aria-controls="tournaments" aria-selected="#{!members_tab_active}"
        | Турниры
    li.nav-item role="presentation"
      button.nav-link class=("active" if members_tab_active) type="button" role="tab" data-bs-toggle="tab" data-bs-target="#league-users" aria-controls="league-users" aria-selected="#{members_tab_active}"
        | Участники
    - if @league.owner == current_user
      li.nav-item role="presentation"
        button.nav-link type="button" role="tab" data-bs-toggle="tab" data-bs-target="#settings" aria-controls="settings" aria-selected="false"
          | Настройки

  .tab-content.mt-3
    #tournaments.tab-pane.fade class=("show active" unless members_tab_active) role="tabpanel"
      .d-flex.justify-content-between.align-items-center.mb-2
        h5.mb-0 Турниры
        - if @league.owner == current_user
          = link_to new_league_tournament_path(@league), class: "btn btn-primary btn-sm", data: { tooltip: "Новый турнир" } do
            i.bi.bi-plus-lg

      - visible_tournaments = @league.owner == current_user ? @league.tournaments : @league.tournaments.where.not(status: :draft)
      - if visible_tournaments.any?
        table.table.table-hover
          thead
            tr
              th Название
              th Даты
              th Место
              th Тип
              th Статус
              th Участники
          tbody
            - visible_tournaments.order(start_date: :asc).each do |tournament|
              tr
                td= link_to tournament.name, tournament_path(tournament)
                td= tournament_date_range(tournament)
                td= tournament.location.presence || "—"
                td= { "olympic" => "Олимпийский", "round_robin" => "Круговой", "mixed" => "Смешанный" }.fetch(tournament.type, tournament.type)
                td
                  - badge_class = { "draft" => "secondary", "registration" => "info", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(tournament.status, "secondary")
                  span.badge class="bg-#{badge_class}"
                    = { "draft" => "Черновик", "registration" => "Регистрация", "active" => "Активный", "completed" => "Завершён", "cancelled" => "Отменён" }.fetch(tournament.status, tournament.status)
                td= "#{tournament.pairs.count * 2} / #{tournament.max_participants}"
      - else
        p.text-muted Турниров пока нет.

    #league-users.tab-pane.fade class=("show active" if members_tab_active) role="tabpanel"
      .d-flex.justify-content-between.align-items-center.mb-3
        h5.mb-0 Участники
        - if @league.owner == current_user
          .d-flex.gap-2
            = link_to new_league_league_user_path(@league), class: "btn btn-outline-secondary btn-sm", data: { tooltip: "Добавить участника" } do
              i.bi.bi-person-add
            span data-tooltip="Пригласить игроков"
              button.btn.btn-primary.btn-sm type="button" data-bs-toggle="modal" data-bs-target="#inviteUsersModal"
                i.bi.bi-envelope-plus

      = search_form_for @q_members, url: league_path(@league), as: :q_members, method: :get, html: { data: { turbo: false } } do |f|
        .row.g-2.align-items-end.mb-3
          .col-sm-4
            = f.label :user_first_name_or_user_last_name_cont, "Имя", class: "form-label small mb-1"
            = f.search_field :user_first_name_or_user_last_name_cont, class: "form-control form-control-sm", placeholder: "Поиск по имени"
          .col-sm-3
            = f.label :user_gender_eq, "Пол", class: "form-label small mb-1"
            = f.select :user_gender_eq, [["Все", ""], ["Мужской", 0], ["Женский", 1]], {}, class: "form-select form-select-sm"
          .col-sm-3
            = label_tag :members_status, "Статус", class: "form-label small mb-1"
            = select_tag :members_status, options_for_select([["Все", ""], ["Активные", "active"], ["Ожидающие", "pending"]], params[:members_status]), class: "form-select form-select-sm"
          .col-sm-2.d-flex.align-items-end.gap-1
            = f.submit "Применить", class: "btn btn-primary btn-sm"
            - if members_tab_active
              = link_to "Сбросить", league_path(@league), class: "btn btn-outline-secondary btn-sm"

      - if @league_users.any?
        table.table.table-hover
          thead
            tr
              th #
              th Фото
              th Имя
              th Пол
              th Очки
              - if @league.owner == current_user
                th
          tbody
            - @league_users.each_with_index do |league_user, index|
              tr
                td= index + 1
                td
                  = render "shared/avatar", user: league_user.user
                td
                  = league_user.full_name
                  - if league_user.user.pending_invitation?
                    span.badge.bg-warning.text-dark.ms-2 Ожидает регистрации
                td
                  - if league_user.user.gender_male?
                    span.badge.badge-gender-male М
                  - elsif league_user.user.gender_female?
                    span.badge.badge-gender-female Ж
                td
                  - if @league.owner == current_user
                    = form_with url: league_league_user_path(@league, league_user), method: :patch, data: { controller: "score-input", turbo: false } do |f|
                      = f.number_field :score, value: league_user.score, class: "form-control form-control-sm", style: "width: 80px;", min: 0, data: { action: "change->score-input#submit" }, name: "league_user[score]"
                  - else
                    = league_user.score
                - if @league.owner == current_user
                  td
                    - if league_user.user.pending_invitation?
                      .d-flex.gap-1
                        = button_tag type: "button", class: "btn btn-outline-secondary btn-sm", data: { copy_url: invitation_url(league_user.user.invitation_token), tooltip: "Скопировать ссылку" } do
                          i.bi.bi-link-45deg
                        = link_to edit_league_league_user_path(@league, league_user), class: "btn btn-outline-primary btn-sm", data: { tooltip: "Редактировать" } do
                          i.bi.bi-pencil
      - elsif members_tab_active
        p.text-muted Участники не найдены.
      - else
        p.text-muted Участников пока нет.

    - if @league.owner == current_user
      #settings.tab-pane.fade role="tabpanel"
        h5.mb-3 Настройки

        .card.mb-3
          .card-header Квота турниров
          .card-body
            p.mb-0 = @league.tournaments_quota

        = form_with model: @league, url: league_path(@league), method: :patch do |f|
          .card.mb-4
            .card-header Telegram чат
            .card-body
              .mb-3
                = f.label :chat_id, "ID чата", class: "form-label"
                = f.text_field :chat_id, class: "form-control", style: "max-width: 280px;", placeholder: "-100xxxxxxxxxx"
                .form-text.mt-1
                  p.fw-bold.mb-1 1. С помощью Telegram-ботов (самый простой способ)
                  ol.ps-3
                    li
                      | Откройте Telegram и введите в строку поиска
                      code  @getmyid_bot
                      |  или
                      code  @userinfobot
                    li Запустите бота, нажав «Старт» (или /start).
                    li
                      strong Для личного чата:
                      |  бот моментально пришлёт ваш User ID.
                    li
                      strong Для группы или канала:
                      |  перешлите любое сообщение из этого чата или канала в бот. В ответ бот пришлёт Chat ID.
                  p.fw-bold.mb-1.mt-2 2. Через веб-версию (для каналов и групп)
                  p.mb-1
                    | Если у вас есть ссылка на чат (вида
                    code  t.me/name
                    | ), можно использовать официальный API:
                  ol.ps-3
                    li
                      | Перейдите по ссылке, заменив данные на свои:
                      code  https://api.telegram.org/bot&lt;ВАШ_ТОКЕН&gt;/getChat?chat_id=@имя_группы
                    li
                      | Ваш токен бота можно получить в
                      code  @BotFather
                    li
                      | В открывшемся окне браузера найдите строку
                      code  "id":
                      |  — это и есть нужный идентификатор (для каналов он обычно начинается с
                      code  -100
                      | ).
            .card-footer
              = f.submit "Сохранить", class: "btn btn-primary"

        = form_with model: @league, url: league_path(@league), method: :patch do |f|
          .card.mb-4
            .card-header Передача прав владельца
            .card-body
              .mb-3
                = f.label :owner_id, "Новый владелец", class: "form-label"
                = f.select :owner_id, @league_members.map { |u| [u.full_name, u.id] }, {}, class: "form-select", style: "max-width: 320px;"
            .card-footer
              = f.submit "Сохранить", class: "btn btn-primary"

- if @league.owner == current_user
  #inviteUsersModal.modal.fade aria-hidden="true" aria-labelledby="inviteUsersModalLabel" tabindex="-1"
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title#inviteUsersModalLabel Пригласить игроков в лигу
          button.btn-close type="button" data-bs-dismiss="modal" aria-label="Close"
        = form_with url: league_league_invitations_path(@league), scope: :league_invitation do |f|
          .modal-body
            .mb-3
              = f.label :invited_user_ids, "Выберите игроков", class: "form-label"
              = f.select :invited_user_ids,
                @invitable_users.map { |u| [u.full_name, u.id] },
                { include_hidden: false },
                { class: "form-select", multiple: true }
          .modal-footer
            button.btn.btn-secondary type="button" data-bs-dismiss="modal" Отмена
            = f.submit "Отправить приглашения", class: "btn btn-primary"
