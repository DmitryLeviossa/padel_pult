.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    .d-flex.align-items-center.gap-3
      - if @league.logo.attached?
        = image_tag @league.logo, class: "rounded", style: "width: 64px; height: 64px; object-fit: cover;"
      h1.mb-0= @league.name
    .d-flex.gap-2
      - if @league.owner == current_user
        = link_to "Редактировать", edit_league_path(@league), class: "btn btn-outline-primary btn-sm"
      = link_to "← Лиги", leagues_path, class: "btn btn-outline-secondary btn-sm"

  - if @league.description.present?
    p.text-muted= @league.description

  p.text-muted.small
    | Создано #{l(@league.created_at.to_date, format: :long)} пользователем #{@league.owner.email}

  ul.nav.nav-tabs.mt-4 role="tablist"
    li.nav-item role="presentation"
      button.nav-link.active type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tournaments" aria-controls="tournaments" aria-selected="true"
        | Турниры
    li.nav-item role="presentation"
      button.nav-link type="button" role="tab" data-bs-toggle="tab" data-bs-target="#league-users" aria-controls="league-users" aria-selected="false"
        | Участники

  .tab-content.mt-3
    #tournaments.tab-pane.fade.show.active role="tabpanel"
      .d-flex.justify-content-between.align-items-center.mb-2
        h5.mb-0 Турниры
        - if @league.owner == current_user
          = link_to "Новый турнир", new_league_tournament_path(@league), class: "btn btn-primary btn-sm"

      - if @league.tournaments.any?
        table.table.table-hover
          thead
            tr
              th Название
              th Дата начала
              th Дата окончания
              th Место
              th Тип
              th Статус
          tbody
            - @league.tournaments.order(start_date: :asc).each do |tournament|
              tr
                td= link_to tournament.name, tournament_path(tournament)
                td= l(tournament.start_date, format: :long)
                td= l(tournament.end_date, format: :long)
                td= tournament.location.presence || "—"
                td= t("tournament.type.#{tournament.type}")
                td= t("tournament.status.#{tournament.status}")
      - else
        p.text-muted Турниров пока нет.

    #league-users.tab-pane.fade role="tabpanel"
      h5.mb-3 Участники

      - if @league.league_users.any?
        table.table.table-hover
          thead
            tr
              th Фото
              th Имя
              th Очки
          tbody
            - @league.league_users.order(score: :desc).each do |league_user|
              tr
                td
                  = render "shared/avatar", user: league_user.user
                td= league_user.full_name
                td= league_user.score
      - else
        p.text-muted Участников пока нет.
