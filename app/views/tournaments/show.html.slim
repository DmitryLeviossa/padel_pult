.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0= @tournament.name
    .d-flex.gap-2
      - if @tournament.draft? && @tournament.league.owner == current_user
        = link_to edit_tournament_path(@tournament), class: "btn btn-outline-primary btn-sm", title: "Редактировать", data: { bs_toggle: "tooltip" } do
          i.bi.bi-pencil
        = button_to open_registration_tournament_path(@tournament), method: :post, class: "btn btn-outline-success btn-sm", title: "Открыть регистрацию", data: { bs_toggle: "tooltip" } do
          i.bi.bi-person-check
        = button_to tournament_path(@tournament), method: :delete, class: "btn btn-outline-danger btn-sm", title: "Удалить турнир", data: { bs_toggle: "tooltip" }, form: { data: { turbo_confirm: "Вы уверены, что хотите удалить этот турнир? Это действие необратимо." } } do
          i.bi.bi-trash
      - if @tournament.registration? && @tournament.league.owner == current_user
        = link_to edit_tournament_path(@tournament), class: "btn btn-outline-primary btn-sm", title: "Редактировать", data: { bs_toggle: "tooltip" } do
          i.bi.bi-pencil
        = button_to activate_tournament_path(@tournament), method: :post, class: "btn btn-success btn-sm", title: "Активировать турнир", data: { bs_toggle: "tooltip" } do
          i.bi.bi-play-fill
        = button_to cancel_tournament_path(@tournament), method: :post, class: "btn btn-outline-danger btn-sm", title: "Отменить турнир", data: { bs_toggle: "tooltip" }, form: { data: { turbo_confirm: "Вы уверены, что хотите отменить этот турнир? Все зарегистрированные участники получат уведомление." } } do
          i.bi.bi-x-circle
      - if !@tournament.completed? && @tournament.league.owner == current_user
        = link_to fill_results_tournament_path(@tournament), class: "btn btn-primary btn-sm", title: "Заполнить результаты", data: { bs_toggle: "tooltip" } do
          i.bi.bi-clipboard-check
      - if @tournament.active? || @tournament.completed?
        = link_to online_tournament_path(@tournament), class: "btn btn-outline-info btn-sm", title: "Онлайн трансляция", target: "_blank", data: { bs_toggle: "tooltip" } do
          i.bi.bi-broadcast
      = link_to league_path(@tournament.league), class: "btn btn-outline-secondary btn-sm", title: @tournament.league.name, data: { bs_toggle: "tooltip" } do
        i.bi.bi-arrow-left

  .row.mb-4
    .col-md-8
      - if @tournament.description.present?
        p.text-muted= @tournament.description

      dl.row
        dt.col-sm-3 Место
        dd.col-sm-9= @tournament.location.presence || "—"

        dt.col-sm-3 Дата
        dd.col-sm-9= tournament_date_range(@tournament)

        dt.col-sm-3 Тип
        dd.col-sm-9= { "olympic" => "Олимпийский", "round_robin" => "Круговой", "mixed" => "Смешанный" }.fetch(@tournament.type, @tournament.type)

        - if @tournament.olympic?
          dt.col-sm-3 Сетка проигравших
          dd.col-sm-9
            - if @tournament.loser_bracket?
              i.bi.bi-check-circle-fill.text-success
            - else
              i.bi.bi-x-circle.text-muted
        - elsif @tournament.mixed?
          dt.col-sm-3 Количество групп
          dd.col-sm-9= @tournament.groups_count
          dt.col-sm-3 Пар в плей-офф из группы
          dd.col-sm-9= @tournament.pairs_to_bracket
          dt.col-sm-3 Сетка проигравших
          dd.col-sm-9
            - if @tournament.loser_bracket?
              i.bi.bi-check-circle-fill.text-success
            - else
              i.bi.bi-x-circle.text-muted

        dt.col-sm-3 Макс. участников
        dd.col-sm-9= @tournament.max_participants

        dt.col-sm-3 Статус
        dd.col-sm-9
          - badge_class = { "draft" => "secondary", "registration" => "info", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(@tournament.status, "secondary")
          span.badge class="bg-#{badge_class}"
            = { "draft" => "Черновик", "registration" => "Регистрация", "active" => "Активный", "completed" => "Завершён", "cancelled" => "Отменён" }.fetch(@tournament.status, @tournament.status)

    - if @tournament.placement_points.present?
      .col-md-4
        h5.mb-3 Очки за места
        table.table.table-sm.table-bordered
          thead.table-light
            tr
              th Место
              th Очки
          tbody
            - @tournament.placement_points.each do |rule|
              tr
                - from = rule["from"].to_i
                - to = rule["to"].to_i
                td= from == to ? from.to_s : "#{from} - #{to}"
                td= rule["points"]

  h4.mt-4.mb-3 Пары

  - if @available_partners
    = form_with url: tournament_pairs_path(@tournament), method: :post, scope: :pair, class: "d-flex align-items-center gap-2 mb-3" do |f|
      = f.select :player2_id,
          @available_partners.map { |lu| [ lu.full_name, lu.id ] },
          { prompt: "— выберите партнёра —" },
          class: "form-select form-select-sm w-auto"
      = f.submit "Подать заявку", class: "btn btn-success btn-sm"
  - elsif @current_league_user
    .alert.alert-info.mb-3 Вы уже зарегистрированы на этот турнир.

  - if @owner_available_players&.size.to_i >= 2
    .d-flex.align-items-center.gap-2.mb-3
      = form_with url: tournament_pairs_path(@tournament), method: :post, scope: :pair, class: "d-flex align-items-center gap-2" do |f|
        = f.select :player1_id,
            @owner_available_players.map { |lu| [ lu.full_name, lu.id ] },
            { prompt: "— Игрок 1 —" },
            class: "form-select form-select-sm", style: "width: 200px;"
        = f.select :player2_id,
            @owner_available_players.map { |lu| [ lu.full_name, lu.id ] },
            { prompt: "— Игрок 2 —" },
            class: "form-select form-select-sm", style: "width: 200px;"
        = f.submit "Добавить пару", class: "btn btn-primary btn-sm"
  - if @tournament.pairs.any?
    table.table.table-hover
      thead
        tr
          - if @tournament.completed?
            th= sort_link(@tournament, "placement", "Место", @sort, @direction)
          - else
            th #
          th Фото
          th= sort_link(@tournament, "player1", "Игрок 1", @sort, @direction)
          th= sort_link(@tournament, "player1_score", "Очки", @sort, @direction)
          th Фото
          th= sort_link(@tournament, "player2", "Игрок 2", @sort, @direction)
          th= sort_link(@tournament, "player2_score", "Очки", @sort, @direction)
          th= sort_link(@tournament, "score", "Очки пары", @sort, @direction)
          th= sort_link(@tournament, "created_at", "Дата подачи заявки", @sort, @direction)
          th Фото пары
          - if @tournament.registration?
            th Сеяная
          - if @tournament.registration? && @tournament.league.owner == current_user
            th
      tbody
        - eligible_pairs = @tournament.eligible_pairs
        - eligible_pair_ids = eligible_pairs.map(&:id).to_set
        - last_eligible_id = @tournament.pairs.size > @tournament.max_pairs ? eligible_pairs.last&.id : nil
        - @pairs.each_with_index do |pair, index|
          - row_style = eligible_pair_ids.include?(pair.id) ? "" : "opacity: 0.45"
          - row_style += "; border-bottom: 2px solid #dc3545 !important" if pair.id == last_eligible_id
          tr style=row_style
            - if @tournament.completed?
              td= pair.placement
            - else
              td= index + 1
            td
              = render "shared/avatar", user: pair.player1.user
            td= pair.player1.full_name
            td= pair.player1_score
            td
              = render "shared/avatar", user: pair.player2.user
            td= pair.player2.full_name
            td= pair.player2_score
            td= pair.score
            td= ru_datetime(pair.created_at)
            td
              - if @tournament.league.owner == current_user
                = form_with url: tournament_pair_path(@tournament, pair), method: :patch, multipart: true, data: {turbo: false} do |f|
                  label style="cursor:pointer;display:block;"
                    = file_field_tag "pair[photo]", accept: "image/*", class: "d-none", onchange: "this.form.submit()"
                    - if pair.photo.attached?
                      i.bi.bi-check-circle-fill.text-success style="font-size:1.2rem;" title="Фото загружено"
                    - else
                      i.bi.bi-camera.text-muted style="font-size:1.2rem;" title="Загрузить фото пары"
              - elsif pair.photo.attached?
                = image_tag pair.photo.variant(resize_to_fill: [80, 80]), class: "rounded", style: "width:40px;height:40px;object-fit:cover;"
            - if @tournament.registration?
              td
                - if @tournament.league.owner == current_user
                  = form_with url: tournament_pair_path(@tournament, pair), method: :patch, class: "d-inline" do |f|
                    = hidden_field_tag "pair[seeded]", "0"
                    = check_box_tag "pair[seeded]", "1", pair.seeded, class: "form-check-input", onchange: "this.form.requestSubmit()", style: "width: 1.2em; height: 1.2em; cursor: pointer;"
                - else
                  - if pair.seeded
                    i.bi.bi-check-circle-fill.text-success
                  - else
                    i.bi.bi-x-circle.text-muted
            - if @tournament.registration? && @tournament.league.owner == current_user
              td= button_to tournament_pair_path(@tournament, pair), method: :delete, class: "btn btn-danger btn-sm", title: "Удалить", form: { data: { turbo_confirm: "Вы уверены, что хотите удалить эту пару?" } } do
                i.bi.bi-trash
  - else
    p.text-muted Пар пока нет.

  - is_owner = @tournament.league.owner == current_user

  - if @matches.any?
    - any_completed = @matches.any?(&:completed?)
    - if @tournament.round_robin?
      = render "matches/round_robin", matches: @matches, tournament: @tournament, is_owner: is_owner, any_completed: any_completed
    - elsif @tournament.olympic?
      = render "matches/olympic_bracket", bracket_rounds: @bracket_rounds, third_place_match: @third_place_match, loser_bracket_rounds: @loser_bracket_rounds, loser_third_place_match: @loser_third_place_match, tournament: @tournament, is_owner: is_owner, any_completed: any_completed
    - elsif @tournament.mixed?
      = render "matches/mixed", group_data: @group_data, bracket_rounds: @bracket_rounds, third_place_match: @third_place_match, loser_bracket_rounds: @loser_bracket_rounds, loser_third_place_match: @loser_third_place_match, tournament: @tournament, is_owner: is_owner, any_completed: any_completed

  - if @custom_bracket_data.any?
    - any_completed ||= false
    - @custom_bracket_data.each do |data|
      = render "brackets/custom_bracket", bracket: data[:bracket], bracket_rounds: data[:rounds], third_place_match: data[:third_place], tournament: @tournament, is_owner: is_owner

  - if is_owner && !@tournament.completed?
    .mt-4
      = link_to "Добавить сетку", new_tournament_bracket_path(@tournament), class: "btn btn-outline-primary btn-sm"

  - if is_owner
    = render "matches/result_modal", matches: @matches, tournament: @tournament
