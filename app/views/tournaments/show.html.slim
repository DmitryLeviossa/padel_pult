.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0= @tournament.name
    = link_to "← #{@tournament.league.name}", league_path(@tournament.league), class: "btn btn-outline-secondary btn-sm"

  .row.mb-4
    .col-md-8
      - if @tournament.description.present?
        p.text-muted= @tournament.description

      dl.row
        dt.col-sm-3 Location
        dd.col-sm-9= @tournament.location.presence || "—"

        dt.col-sm-3 Start Date
        dd.col-sm-9= @tournament.start_date.strftime("%b %d, %Y")

        dt.col-sm-3 End Date
        dd.col-sm-9= @tournament.end_date.strftime("%b %d, %Y")

        dt.col-sm-3 Type
        dd.col-sm-9= @tournament.type.capitalize

        dt.col-sm-3 Max Participants
        dd.col-sm-9= @tournament.max_participants

        dt.col-sm-3 Status
        dd.col-sm-9
          - badge_class = { "draft" => "secondary", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(@tournament.status, "secondary")
          span class="badge bg-#{badge_class}" = @tournament.status.capitalize

  h4.mt-4.mb-3 Pairs
  - if @tournament.pairs.any?
    table.table.table-hover
      thead
        tr
          th #
          th Player 1
          th Player 2
      tbody
        - @tournament.pairs.each_with_index do |pair, index|
          tr
            td= index + 1
            td= pair.player1.email
            td= pair.player2.email
  - else
    p.text-muted No pairs registered yet.
