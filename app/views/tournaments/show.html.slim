.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0= @tournament.name
    = link_to "← #{@tournament.league.name}", league_path(@tournament.league), class: "btn btn-outline-secondary btn-sm"

  .row.mb-4
    .col-md-8
      - if @tournament.description.present?
        p.text-muted= @tournament.description

      dl.row
        dt.col-sm-3 Место
        dd.col-sm-9= @tournament.location.presence || "—"

        dt.col-sm-3 Дата начала
        dd.col-sm-9= @tournament.start_date.strftime("%d.%m.%Y")

        dt.col-sm-3 Дата окончания
        dd.col-sm-9= @tournament.end_date.strftime("%d.%m.%Y")

        dt.col-sm-3 Тип
        dd.col-sm-9= @tournament.type.capitalize

        dt.col-sm-3 Макс. участников
        dd.col-sm-9= @tournament.max_participants

        dt.col-sm-3 Статус
        dd.col-sm-9
          - badge_class = { "draft" => "secondary", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(@tournament.status, "secondary")
          span.badge class="bg-#{badge_class}"
            = @tournament.status.capitalize

  h4.mt-4.mb-3 Пары
  - if @tournament.pairs.any?
    table.table.table-hover
      thead
        tr
          th #
          th Фото
          th Игрок 1
          th Очки
          th Фото
          th Игрок 2
          th Очки
          th Очки пары
      tbody
        - @tournament.pairs.sort_by { |p| -p.score }.each_with_index do |pair, index|
          tr
            td= index + 1
            td
              = render "shared/avatar", user: pair.player1.user
            td= pair.player1.full_name
            td= pair.player1.score
            td
              = render "shared/avatar", user: pair.player2.user
            td= pair.player2.full_name
            td= pair.player2.score
            td= pair.score
  - else
    p.text-muted Пар пока нет.
