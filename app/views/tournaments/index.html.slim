.container.py-4
  h1.mb-4= t('.title')

  = search_form_for @q, url: tournaments_path, method: :get, html: { class: "mb-4", data: { auto_submit: "" } } do |f|
    .row.g-2.align-items-end
      .col-md-3
        label.form-label= t('.name_label')
        = f.search_field :name_cont, class: "form-control", placeholder: t('.search_placeholder')
      .col-md-2
        label.form-label= t('.location_label')
        = f.search_field :location_cont, class: "form-control", placeholder: t('.location_placeholder')
      .col-md-3
        label.form-label= t('.status_label')
        = f.select :status_in, Tournament.statuses.keys.map { |s| [t("tournament.status.#{s}"), s] }.reject { |_, s| s == "draft" }, {}, class: "form-select", multiple: true
      .col-md-2
        label.form-label= t('.type_label')
        = f.select :type_eq, [["", ""]] + Tournament.types.keys.map { |tp| [t("tournament.type.#{tp}"), tp] }, {}, class: "form-select"
      .col-md-2
        = link_to t('.reset'), tournaments_path, class: "btn btn-outline-secondary"

  - if @tournaments.any?
    table.table.table-hover
      thead
        tr
          th= t('.name_column')
          th= t('.location_column')
          th= t('.dates_column')
          th= t('.type_column')
          th= t('.status_column')
          th= t('.max_participants_column')
      tbody
        - @tournaments.each do |tournament|
          tr
            td= link_to tournament.name, tournament_path(tournament)
            td= tournament.location.presence || "—"
            td= "#{l(tournament.start_date, format: :long)} — #{l(tournament.end_date, format: :long)}"
            td= t("tournament.type.#{tournament.type}")
            td
              - badge_class = { "draft" => "secondary", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(tournament.status, "secondary")
              span.badge class="bg-#{badge_class}"
                = t("tournament.status.#{tournament.status}")
            td.text-center= "#{tournament.pairs.size * 2}/#{tournament.max_participants}"
  - else
    p.text-muted= t('.no_tournaments')
