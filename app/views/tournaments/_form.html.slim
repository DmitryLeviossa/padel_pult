= form_with model: form_model, class: "row g-3", data: { controller: "tournament-type" } do |f|
  - base_errors = tournament.errors[:base]
  - if base_errors.any?
    .col-12
      .alert.alert-danger
        - base_errors.each do |msg|
          div= msg

  .col-md-6
    = f.label :name, "Название", class: "form-label"
    = f.text_field :name, class: "form-control #{"is-invalid" if tournament.errors[:name].any?}"
    - if tournament.errors[:name].any?
      .invalid-feedback= tournament.errors[:name].first

  .col-md-6
    = f.label :club_id, "Клуб", class: "form-label"
    = f.select :club_id, Club.all.map { |c| [c.name, c.id] }, { prompt: "— выберите клуб —" }, class: "form-select"

  .col-md-3
    label.form-label for="tournament_start_date_picker" Дата и время начала
    = f.hidden_field :start_date, id: "tournament_start_date"
    input#tournament_start_date_picker.form-control type="text" placeholder="Выберите дату и время" readonly="true" class="#{"is-invalid" if tournament.errors[:start_date].any?}" data-value=tournament.start_date&.strftime("%d.%m.%Y %H:%M")
    - if tournament.errors[:start_date].any?
      .invalid-feedback= tournament.errors[:start_date].first

  .col-md-3
    label.form-label for="tournament_end_date_picker" Дата и время окончания
    = f.hidden_field :end_date, id: "tournament_end_date"
    input#tournament_end_date_picker.form-control type="text" placeholder="Выберите дату и время" readonly="true" class="#{"is-invalid" if tournament.errors[:end_date].any?}" data-value=tournament.end_date&.strftime("%d.%m.%Y %H:%M")
    - if tournament.errors[:end_date].any?
      .invalid-feedback= tournament.errors[:end_date].first

  .col-md-3
    = f.label :max_participants, "Макс. участников", class: "form-label"
    = f.number_field :max_participants, class: "form-control", min: 2

  .col-md-3
    = f.label :type, "Тип", class: "form-label"
    = f.select :type, Tournament.types.keys.map { |tp| [{ "olympic" => "Олимпийский", "round_robin" => "Круговой", "mixed" => "Смешанный", "americano" => "Американо" }.fetch(tp, tp), tp] }, {}, class: "form-select", data: { tournament_type_select: true, action: "change->tournament-type#toggle" }

  .col-12(data-tournament-type-target="americanoConfig" class=("d-none" unless tournament.americano?))
    hr
    h5.mb-3 Настройки американо
    .row.g-3
      .col-md-4
        = f.label :rounds_count, "Количество раундов", class: "form-label"
        = f.number_field :rounds_count, class: "form-control #{"is-invalid" if tournament.errors[:rounds_count].any?}", min: 1
        - if tournament.errors[:rounds_count].any?
          .invalid-feedback= tournament.errors[:rounds_count].first
        - else
          small.form-text.text-muted Сколько раундов сыграет каждый игрок

  .col-12(data-tournament-type-target="mixedConfig" class=("d-none" unless tournament.mixed?))
    hr
    h5.mb-3 Настройки группового этапа
    .row.g-3
      .col-md-4
        = f.label :groups_count, "Количество групп", class: "form-label"
        = f.number_field :groups_count, class: "form-control #{"is-invalid" if tournament.errors[:groups_count].any?}", min: 1
        - if tournament.errors[:groups_count].any?
          .invalid-feedback= tournament.errors[:groups_count].first
      .col-md-4
        = f.label :pairs_to_bracket, "Пар в плей-офф из группы", class: "form-label"
        = f.number_field :pairs_to_bracket, class: "form-control #{"is-invalid" if tournament.errors[:pairs_to_bracket].any?}", min: 1
        - if tournament.errors[:pairs_to_bracket].any?
          .invalid-feedback= tournament.errors[:pairs_to_bracket].first
        - elsif tournament.groups_count.to_i > 0 && tournament.pairs_to_bracket.to_i > 0
          small.form-text.text-muted Итого #{tournament.pairs_to_bracket.to_i * tournament.groups_count.to_i} пар в плей-офф
        - elsif tournament.groups_count.to_i > 0
          small.form-text.text-muted Топ N пар из каждой группы проходят в плей-офф
      .col-md-4.d-flex.align-items-end
        .form-check.mb-2
          = f.check_box :loser_bracket, class: "form-check-input"
          = f.label :loser_bracket, "Сетка проигравших", class: "form-check-label"

  .col-12(data-tournament-type-target="olympicConfig" class=("d-none" unless tournament.olympic?))
    hr
    .row.g-3
      .col-md-4.d-flex.align-items-end
        .form-check.mb-2
          = f.check_box :loser_bracket, class: "form-check-input"
          = f.label :loser_bracket, "Сетка проигравших", class: "form-check-label"

  .col-12
    = f.label :description, "Описание", class: "form-label"
    = f.text_area :description, class: "form-control", rows: 3

  .col-12
    hr
    h5.mb-3 Очки за места
    - if tournament.errors[:placement_points].any?
      .alert.alert-danger
        - tournament.errors[:placement_points].each do |msg|
          div= msg

    div data-controller="placement-points"
      div data-placement-points-target="list"
        - Array(tournament.placement_points).each_with_index do |rule, i|
          .placement-row.row.g-2.align-items-center.mb-2
            .col-auto
              small.text-muted С места
              input.form-control.form-control-sm type="number" name="tournament[placement_points][#{i}][from]" value=rule["from"] min="1" style="width: 80px"
            .col-auto
              small.text-muted По место
              input.form-control.form-control-sm type="number" name="tournament[placement_points][#{i}][to]" value=rule["to"] min="1" style="width: 80px"
            .col-auto
              small.text-muted Очки
              input.form-control.form-control-sm type="number" name="tournament[placement_points][#{i}][points]" value=rule["points"] min="1" style="width: 80px"
            .col-auto.pt-3
              button.btn.btn-outline-danger.btn-sm type="button" data-action="placement-points#removeRow" = "×"

      template data-placement-points-target="template"
        .placement-row.row.g-2.align-items-center.mb-2
          .col-auto
            small.text-muted С места
            input.form-control.form-control-sm type="number" name="tournament[placement_points][__INDEX__][from]" min="1" style="width: 80px"
          .col-auto
            small.text-muted По место
            input.form-control.form-control-sm type="number" name="tournament[placement_points][__INDEX__][to]" min="1" style="width: 80px"
          .col-auto
            small.text-muted Очки
            input.form-control.form-control-sm type="number" name="tournament[placement_points][__INDEX__][points]" min="1" style="width: 80px"
          .col-auto.pt-3
            button.btn.btn-outline-danger.btn-sm type="button" data-action="placement-points#removeRow" = "×"

      button.btn.btn-outline-secondary.btn-sm.mt-1 type="button" data-action="placement-points#addRow"
        | + Добавить правило

  .col-12
    = f.submit submit_label, class: "btn btn-primary"
