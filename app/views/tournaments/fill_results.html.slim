.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0= "Результаты: #{@tournament.name}"
    = link_to "← #{@tournament.name}", tournament_path(@tournament), class: "btn btn-outline-secondary btn-sm"

  - if @tournament.americano?
    - if @americano_standings.any?
      p.text-muted Рейтинг рассчитывается автоматически по набранным очкам. Нажмите «Завершить турнир» для подтверждения.
      table.table.table-hover.mb-4
        thead
          tr
            th Место
            th Игрок
            th.text-center Очки турнира
        tbody
          - @americano_standings.each_with_index do |participant, i|
            tr
              td= i + 1
              td= participant.league_user.full_name
              td.text-center= participant.total_score
      = button_to "Завершить турнир", complete_tournament_path(@tournament), method: :patch, class: "btn btn-success"
    - else
      p.text-muted Участников пока нет.
  - elsif @pairs.any?
    = form_with url: complete_tournament_path(@tournament), method: :patch do |f|
      table.table.table-hover
        thead
          tr
            th Пара
            th.text-center Место
        tbody
          - @pairs.each do |pair|
            tr
              td= "#{pair.player1.full_name} / #{pair.player2.full_name}"
              td.text-center
                - suggested = pair.placement || @suggested_placements&.dig(pair.id)
                = number_field_tag "placements[#{pair.id}]", suggested, min: 1, max: @tournament.pairs.size, class: "form-control form-control-sm d-inline-block", style: "width: 80px"

      .mt-3
        = f.submit "Завершить турнир", class: "btn btn-success"
  - else
    p.text-muted Пар пока нет.
