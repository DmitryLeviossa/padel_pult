.container.py-4
  h1.mb-4= t('.title')

  = search_form_for @q, url: users_path, method: :get, html: { class: "mb-4" } do |f|
    .row.g-2.align-items-end
      .col-md-4
        label.form-label= t('.name_label')
        = f.search_field :full_name_cont, class: "form-control", placeholder: t('.search_placeholder')
      .col-md-2
        label.form-label= t('.gender_label')
        = f.select :gender_eq, options_for_select([[t('.gender_all'), nil]] + User.genders.keys.map { |g| [t("activerecord.attributes.user.genders.#{g}"), g] }, params.dig(:q, :gender_eq)), {}, class: "form-select"
      .col-md-2
        .d-flex.gap-2
          = f.submit t('.submit'), class: "btn btn-primary"
          = link_to t('.reset'), users_path, class: "btn btn-outline-secondary"

  - if @users.any?
    .d-flex.flex-column.gap-2
      - @users.each do |user|
        .card.card-hoverable.w-100.overflow-hidden style="height: 250px;"
          .d-flex.h-100
            .flex-shrink-0 style="width: 25%;"
              - if user.photo.attached?
                = image_tag user.photo.variant(resize_to_fill: [400, 500]), style: "width: 100%; height: 100%; object-fit: cover;"
              - else
                - initials = user.full_name.split.map(&:first).first(2).join.upcase
                .d-flex.align-items-center.justify-content-center.h-100 style="background: var(--color-bg-surface); border-right: 1px solid var(--color-border); font-size: 3rem; font-weight: 600; color: var(--color-text-muted);"
                  = initials
            .d-flex.flex-column.justify-content-between.flex-grow-1.p-3
              div
                = link_to user.full_name, user_path(user), class: "fw-semibold fs-5 text-reset text-decoration-none stretched-link"
                .d-flex.flex-wrap.gap-1.mt-2
                  - user.leagues.each do |league|
                    = link_to league.name, league_path(league), class: "badge text-bg-secondary text-decoration-none position-relative"
              .d-flex.align-items-center.justify-content-between
                - if user.gender_male?
                  span.badge.badge-gender-male М
                - elsif user.gender_female?
                  span.badge.badge-gender-female Ж
                - else
                  span
                small.text-muted= l(user.created_at.to_date, format: :long)
  - else
    p.text-muted= t('.no_users')
