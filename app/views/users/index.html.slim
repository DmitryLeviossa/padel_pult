.container.py-4
  h1.mb-4 Пользователи

  = search_form_for @q, url: users_path, method: :get, html: { class: "mb-4" } do |f|
    .row.g-2.align-items-end
      .col-md-4
        label.form-label Имя
        = f.search_field :full_name_cont, class: "form-control", placeholder: "Поиск по имени"
      .col-md-2
        label.form-label Пол
        = f.select :gender_eq, options_for_select([["Все", nil]] + User.genders.keys.map { |g| [{ "male" => "Мужской", "female" => "Женский" }.fetch(g, g), g] }, params.dig(:q, :gender_eq)), {}, class: "form-select"
      .col-md-2
        .d-flex.gap-2
          = f.submit "Применить", class: "btn btn-primary"
          = link_to "Сбросить", users_path, class: "btn btn-outline-secondary"

  - if @users.any?
    .d-flex.flex-column.gap-2
      - @users.each do |user|
        .card.card-hoverable.w-100.overflow-hidden style="height: 250px;"
          .d-flex.h-100
            .flex-shrink-0 style="width: 25%;"
              - if user.photo.attached?
                = image_tag user.photo.variant(resize_to_fill: [400, 500]), style: "width: 100%; height: 100%; object-fit: cover;"
              - else
                = image_tag "/default_user_photo.svg", style: "width: 100%; height: 100%; object-fit: cover;"
            .d-flex.flex-column.justify-content-between.flex-grow-1.p-3
              div
                .d-flex.align-items-center.gap-2
                  = link_to user.full_name, user_path(user), class: "fw-semibold fs-5 text-reset text-decoration-none stretched-link"
                  - if user.gender_male?
                    span.badge.badge-gender-male М
                  - elsif user.gender_female?
                    span.badge.badge-gender-female Ж
                  - if user.pending_invitation?
                    span.badge.bg-warning.text-dark Ожидает регистрации
                .d-flex.flex-wrap.gap-2.mt-2
                  - user.leagues.each do |league|
                    = link_to league_path(league), class: "position-relative d-inline-block text-decoration-none", title: league.name do
                      - if league.logo.attached?
                        = image_tag league.logo, style: "width: 90px; height: 90px; object-fit: cover; border-radius: 8px;"
                      - else
                        - league_initials = league.name.split.map(&:first).first(2).join.upcase
                        span.d-inline-flex.align-items-center.justify-content-center style="width: 90px; height: 90px; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 8px; font-size: 20px; font-weight: 700; color: var(--color-text-muted);"
                          = league_initials
  - else
    p.text-muted Пользователей пока нет.
