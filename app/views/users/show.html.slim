.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.mb-0= @user.full_name
    = link_to "← Игроки", users_path, class: "btn btn-outline-secondary btn-sm"

  .row.g-4
    .col-md-3
      .card
        - if @user.photo.attached?
          = image_tag @user.photo.variant(resize_to_fill: [600, 600]), class: "card-img-top", style: "object-fit: cover; aspect-ratio: 1;"
        - else
          = image_tag "/default_user_photo.svg", class: "card-img-top", style: "object-fit: cover; aspect-ratio: 1;"
        .card-body
          - if @user.gender_male?
            span.badge.badge-gender-male.mb-2 М
          - elsif @user.gender_female?
            span.badge.badge-gender-female.mb-2 Ж

          dl.mb-0
            dt.small.text-muted Участник с
            dd.mb-2= ru_date(@user.created_at.to_date)

    .col-md-9
      - if @league_standings.any?
        h4.mb-3 Лиги
        .row.g-3.mb-4
          - @league_standings.each do |standing|
            - league = standing[:league]
            - lu = standing[:league_user]
            .col-sm-6.col-lg-4
              .card.h-100
                .card-body
                  .d-flex.align-items-center.gap-3.mb-3
                    - if league.logo.attached?
                      = image_tag league.logo.variant(resize_to_fill: [48, 48]), class: "rounded", style: "width:48px;height:48px;object-fit:cover;flex-shrink:0;"
                    - else
                      .rounded.bg-secondary.d-flex.align-items-center.justify-content-center style="width:48px;height:48px;flex-shrink:0;"
                        i.bi.bi-trophy.text-white
                    div.overflow-hidden
                      h6.mb-0.text-truncate= link_to league.name, league_path(league), class: "text-decoration-none"
                  .d-flex.gap-4
                    div
                      .small.text-muted Место
                      .fw-bold.fs-5
                        - cup = { 1 => "🥇", 2 => "🥈", 3 => "🥉" }[standing[:position]]
                        - if cup
                          = cup
                          = " #{standing[:position]}"
                        - else
                          = standing[:position]
                      .small.text-muted= "из #{standing[:total]}"
                    div
                      .small.text-muted Очки
                      .fw-bold.fs-5= lu.score

      h4.mb-3 История турниров
      - if @tournament_pairs.any?
        .table-responsive
          table.table.table-hover
            thead
              tr
                th Турнир
                th Лига
                th Дата
                th Статус
                th Место
                th Партнёр
                th Очки
            tbody
              - @tournament_pairs.each do |pair|
                - tournament = pair.tournament
                - partner = pair.partner_for(@league_user_ids)
                tr
                  td= link_to tournament.name, tournament_path(tournament), class: "text-decoration-none fw-semibold"
                  td= link_to tournament.league.name, league_path(tournament.league), class: "text-decoration-none text-muted"
                  td.text-nowrap= ru_date(tournament.start_date.to_date)
                  td
                    - badge_class = { "draft" => "secondary", "registration" => "info", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(tournament.status, "secondary")
                    span.badge class="bg-#{badge_class}"
                      = { "draft" => "Черновик", "registration" => "Регистрация", "active" => "Активный", "completed" => "Завершён", "cancelled" => "Отменён" }.fetch(tournament.status, tournament.status)
                  td= pair.placement.present? ? pair.placement : "—"
                  td
                    .d-flex.align-items-center.gap-2
                      = render "shared/avatar", user: partner.user, size: 28
                      = partner.full_name
                  td= pair.score
      - else
        p.text-muted Турниров пока нет.

      - if @match_history.any?
        h4.mt-4.mb-3 История матчей
        .table-responsive
          table.table.table-hover.align-middle
            thead
              tr
                th Турнир
                th Партнёр
                th Соперники
                th Счёт
                th Результат
                th
            tbody
              - @match_history.each do |match|
                - user_pair = [match.pair1, match.pair2].compact.find { |p| (@league_user_ids & [p.player1_id, p.player2_id]).any? }
                - opponent_pair = ([match.pair1, match.pair2].compact - [user_pair]).first
                - partner = user_pair&.partner_for(@league_user_ids)
                - won = user_pair && match.winner_id == user_pair.id
                - lost = match.winner_id.present? && !won
                tr
                  td= link_to match.tournament.name, tournament_path(match.tournament), class: "text-decoration-none fw-semibold"
                  td
                    - if partner
                      .d-flex.align-items-center.gap-2
                        = render "shared/avatar", user: partner.user, size: 28
                        = partner.short_name
                    - else
                      span.text-muted —
                  td.text-muted
                    - if opponent_pair
                      = match.pair_display_name(opponent_pair)
                    - else
                      | —
                  td
                    - if match.sets_score_summary.present?
                      = match.sets_score_summary
                    - else
                      span.text-muted —
                  td
                    - if match.winner_id.present?
                      span.badge class=(won ? "bg-success" : "bg-danger")
                        = won ? "Победа" : "Поражение"
                    - else
                      span.text-muted —
                  td.text-end
                    - if match.result_card_image.attached?
                      a href=url_for(match.result_card_image) target="_blank"
                        = image_tag match.result_card_image.variant(resize_to_limit: [200, 140]), class: "rounded", style: "height:70px;width:auto;object-fit:cover;"
