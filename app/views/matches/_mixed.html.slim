- pairs_options = tournament.pairs.map { |p| [p.player1.full_name + " / " + p.player2.full_name, p.id] }

css:
  .bracket-round { display: flex; flex-direction: column; min-width: 240px; padding: 0 16px; position: relative; }
  .bracket-round:not(:last-child)::after { content: ''; position: absolute; right: 0; top: 5%; height: 90%; border-right: 2px dashed var(--bs-border-color); }
  .bracket-round-header { text-align: center; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--bs-secondary-color); margin-bottom: 8px; flex-shrink: 0; }
  .bracket-match-wrapper { display: flex; flex-direction: column; justify-content: center; min-height: 80px; }
  .bracket-match { border: 1px solid var(--bs-border-color); border-radius: 8px; overflow: hidden; background: var(--bs-secondary-bg); box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
  .bracket-team { padding: 8px 12px; font-size: 13px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bs-border-color); min-height: 38px; color: var(--bs-body-color); gap: 8px; }
  .bracket-team:last-child { border-bottom: none; }
  .bracket-team.winner { font-weight: 700; background-color: rgba(25,135,84,0.2); color: var(--bs-success); }
  .bracket-team.loser { color: var(--bs-secondary-color); }
  .bracket-team.empty-slot { color: var(--bs-tertiary-color); font-style: italic; }
  .bracket-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bracket-score { font-size: 13px; font-weight: 700; min-width: 20px; text-align: right; flex-shrink: 0; }
  .bracket-team.winner .bracket-score { color: var(--bs-success); }
  .bracket-team.loser  .bracket-score { color: var(--bs-secondary-color); }
  .bracket-enter-btn { font-size: 11px; padding: 2px 8px; margin-top: 5px; align-self: flex-end; }
  .bracket-pair-select { flex: 1; font-size: 11px; padding: 2px 4px; border: 1px solid var(--bs-border-color); background: var(--bs-body-bg); color: var(--bs-body-color); border-radius: 4px; min-width: 0; }
  .tournament-bracket { display: flex; align-items: stretch; overflow-x: auto; padding-bottom: 8px; justify-content: center; }
  .group-cross-table td.diagonal { background-color: var(--bs-secondary-bg); }
  .group-cross-table td.score-cell { font-size: 13px; font-weight: 600; white-space: nowrap; }
  .group-cross-table td.score-win { color: var(--bs-success); }
  .group-cross-table td.score-loss { color: var(--bs-danger); }
  .group-cross-table .enter-score-btn { font-size: 11px; padding: 1px 6px; }
  .group-cross-table tr.seeded-row > td:first-child,
  .group-cross-table tr.seeded-row > td:nth-child(2) { background-color: rgba(255, 193, 7, 0.08); }
  .group-cross-table th.seeded-col { background-color: rgba(255, 193, 7, 0.08); }

/ ── Group stage ────────────────────────────────────────────────────────────
.d-flex.justify-content-between.align-items-center.mt-4.mb-3
  h4.mb-0 Групповой этап
  - if is_owner && !tournament.completed?
    - unless any_completed
      = button_to "Переставить пары", auto_assign_pairs_tournament_path(tournament), method: :post, class: "btn btn-outline-secondary btn-sm"

.row
  - group_data.each do |gd|
    .col-md-6
      h5.mt-3.mb-2= "Группа #{gd[:group_number]}"
      .table-responsive
        table.table.table-bordered.table-sm.group-cross-table
          thead.table-light
            tr
              th.text-center №
              th Пара
              - gd[:pairs_ordered].each_with_index do |col_pair, i|
                th.text-center(class=(col_pair.seeded? ? "seeded-col" : nil))= "#{i + 1})"
              th.text-center В
              th.text-center Разница
              th.text-center Место
          tbody
            - gd[:pairs_ordered].each_with_index do |pair, row_idx|
              - stat = gd[:stats_by_id][pair.id]
              tr class=(pair.seeded? ? "seeded-row" : nil)
                td.text-center= row_idx + 1
                td= pair.player1.full_name + " / " + pair.player2.full_name
                - gd[:pairs_ordered].each_with_index do |opp, col_idx|
                  - if row_idx == col_idx
                    td.diagonal.text-center
                  - else
                    - score = gd[:scores][pair.id][opp.id]
                    - match = gd[:match_for][pair.id][opp.id]
                    - can_edit = is_owner && match && !match.has_downstream_results? && !tournament.completed?
                    - if score
                      - win = score[0] > score[1]
                      - cell_sets = match&.match_sets || []
                      - cell_is_pair2 = match && match.pair2_id == pair.id
                      td.score-cell.text-center class=(win ? "score-win" : "score-loss")
                        - if can_edit
                          button.btn.btn-link.p-0.border-0.enter-score-btn style="color:inherit;text-decoration:none;cursor:pointer;" data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}" title="Изменить результат"
                            - if cell_sets.any?
                              - cell_sets.each do |set|
                                span.d-block= cell_is_pair2 ? "#{set.pair2_score}:#{set.pair1_score}" : "#{set.pair1_score}:#{set.pair2_score}"
                            - else
                              = "#{score[0]}/#{score[1]}"
                        - else
                          - if match
                            = link_to result_card_tournament_match_path(tournament, match), target: "_blank", style: "color:inherit;text-decoration:none;" do
                              - if cell_sets.any?
                                - cell_sets.each do |set|
                                  span.d-block= cell_is_pair2 ? "#{set.pair2_score}:#{set.pair1_score}" : "#{set.pair1_score}:#{set.pair2_score}"
                              - else
                                = "#{score[0]}/#{score[1]}"
                          - else
                            - if cell_sets.any?
                              - cell_sets.each do |set|
                                span.d-block= cell_is_pair2 ? "#{set.pair2_score}:#{set.pair1_score}" : "#{set.pair1_score}:#{set.pair2_score}"
                            - else
                              = "#{score[0]}/#{score[1]}"
                    - elsif match && can_edit && !match.completed?
                      td.text-center
                        button.btn.btn-outline-secondary.btn-sm.enter-score-btn data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}"
                          | —
                    - else
                      td.text-center.text-muted —
                td.text-center= stat[:wins]
                td.text-center
                  - diff = stat[:games_diff]
                  = diff > 0 ? "+#{diff}" : diff.to_s
                td.text-center.fw-semibold= stat[:place]

/ ── Main bracket ───────────────────────────────────────────────────────────
- if bracket_rounds.any?
  .d-flex.justify-content-between.align-items-center.mt-5.mb-3
    h4.mb-0 Сетка
    - if is_owner && !tournament.completed?
      .d-flex.gap-2
        - if tournament.active?
          - all_done = tournament.all_matches_completed?
          = link_to "Завершить турнир", fill_results_tournament_path(tournament), class: "btn btn-success btn-sm#{' disabled' unless all_done}", aria: { disabled: (true unless all_done) }, tabindex: (all_done ? nil : "-1")

  - total_rounds = bracket_rounds.length
  .tournament-bracket
    - bracket_rounds.each_with_index do |round_matches, idx|
      - round_num = idx + 1
      - round_label = round_num == total_rounds ? "Финал" : round_num == total_rounds - 1 && total_rounds > 2 ? "Полуфинал" : "Раунд #{round_num}"
      .bracket-round
        .bracket-round-header= round_label
        - slot_height = 116 * (2 ** idx)
        - round_matches.each do |match|
          .bracket-match-wrapper style="min-height: #{slot_height}px;"
            - can_edit_pairs = is_owner && !match.completed? && !match.bye? && match.round_number == 1
            - can_enter_result = is_owner && !match.bye? && match.pair1.present? && match.pair2.present? && !match.has_downstream_results? && !tournament.completed?
            - if can_edit_pairs
              = form_with url: assign_pairs_tournament_match_path(tournament, match), method: :patch, id: "pairs-form-#{match.id}", data: {turbo: false} do
                / empty
            .bracket-match
              - sets = match.match_sets
              - [[match.pair1, match.pair1_score, match.pair1_id, :pair1_id, 0], [match.pair2, match.pair2_score, match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
                - is_winner = match.winner_id.present? && match.winner_id == pair_id
                - is_loser  = match.winner_id.present? && pair_id.present? && match.winner_id != pair_id
                - css_class = pair.nil? ? "empty-slot" : (is_winner ? "winner" : (is_loser ? "loser" : ""))
                .bracket-team class=css_class
                  - if can_edit_pairs
                    select.bracket-pair-select form="pairs-form-#{match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{match.id}').requestSubmit()"
                      option value="" selected=(pair_id.nil?) — …
                      - pairs_options.each do |label, id|
                        option value=id selected=(pair_id == id) = label
                  - else
                    span.bracket-name= pair ? match.pair_display_name(pair) : "…"
                  - if sets.any?
                    .d-flex.gap-1
                      - sets.each do |set|
                        span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
                  - elsif score.present?
                    span.bracket-score= score
            - if can_enter_result
              - btn_label = match.completed? ? "Изменить результат" : "Ввести результат"
              button.btn.btn-outline-primary.btn-sm.bracket-enter-btn data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}"
                = btn_label
            - if is_owner && !match.completed? && !match.bye? && !(match.pair1.present? && match.pair2.present?)
              = link_to "Завершить матч", finish_tournament_match_path(tournament, match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn"
            - if match.completed? && match.pair1.present? && match.pair2.present?
              = link_to result_card_tournament_match_path(tournament, match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn" do
                i.bi.bi-image

  - if third_place_match
    .mt-4.d-flex.flex-column.align-items-center
      .bracket-round-header.mb-2 Матч за 3-е место
      .d-flex.flex-column style="min-width: 240px; max-width: 360px;"
        - can_edit_tp = is_owner && !third_place_match.completed? && !third_place_match.bye?
        - if can_edit_tp
          = form_with url: assign_pairs_tournament_match_path(tournament, third_place_match), method: :patch, id: "pairs-form-#{third_place_match.id}", data: {turbo: false} do
            / empty
        .bracket-match
          - tp_sets = third_place_match.match_sets
          - [[third_place_match.pair1, third_place_match.pair1_score, third_place_match.pair1_id, :pair1_id, 0], [third_place_match.pair2, third_place_match.pair2_score, third_place_match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
            - is_winner = third_place_match.winner_id.present? && third_place_match.winner_id == pair_id
            - is_loser  = third_place_match.winner_id.present? && pair_id.present? && third_place_match.winner_id != pair_id
            - css_class = pair.nil? ? "empty-slot" : (is_winner ? "winner" : (is_loser ? "loser" : ""))
            .bracket-team class=css_class
              - if can_edit_tp
                select.bracket-pair-select form="pairs-form-#{third_place_match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{third_place_match.id}').requestSubmit()"
                  option value="" selected=(pair_id.nil?) — …
                  - pairs_options.each do |label, id|
                    option value=id selected=(pair_id == id) = label
              - else
                span.bracket-name= pair ? third_place_match.pair_display_name(pair) : "…"
              - if tp_sets.any?
                .d-flex.gap-1
                  - tp_sets.each do |set|
                    span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
              - elsif score.present?
                span.bracket-score= score
        - if is_owner && !tournament.completed? && !third_place_match.bye? && third_place_match.pair1.present? && third_place_match.pair2.present? && !third_place_match.has_downstream_results?
          - tp_btn_label = third_place_match.completed? ? "Изменить результат" : "Ввести результат"
          button.btn.btn-outline-primary.btn-sm.bracket-enter-btn.mt-1 data-bs-toggle="modal" data-bs-target="#match-modal-#{third_place_match.id}"
            = tp_btn_label
        - if is_owner && !third_place_match.completed? && !third_place_match.bye? && !(third_place_match.pair1.present? && third_place_match.pair2.present?)
          = link_to "Завершить матч", finish_tournament_match_path(tournament, third_place_match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn mt-1"
        - if third_place_match.completed? && third_place_match.pair1.present? && third_place_match.pair2.present?
          = link_to result_card_tournament_match_path(tournament, third_place_match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn mt-1" do
            i.bi.bi-image

/ ── Consolation bracket ─────────────────────────────────────────────────────
- if loser_bracket_rounds&.any?
  h4.mt-5.mb-3 Утешительная сетка

  - total_rounds = loser_bracket_rounds.length
  .tournament-bracket
    - loser_bracket_rounds.each_with_index do |round_matches, idx|
      - round_num = idx + 1
      - round_label = round_num == total_rounds ? "Финал" : "Раунд #{round_num}"
      .bracket-round
        .bracket-round-header= round_label
        - slot_height = 116 * (2 ** idx)
