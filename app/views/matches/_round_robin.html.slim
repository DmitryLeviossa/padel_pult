- pairs_options = tournament.pairs.map { |p| [p.player1.full_name + " / " + p.player2.full_name, p.id] }

- completed_matches = matches.select { |m| m.completed? && m.pair1_id.present? && m.pair2_id.present? }
- if completed_matches.any?
  - standings = {}
  - head_to_head = {}
  - tournament.pairs.each { |pair| standings[pair.id] = { pair: pair, wins: 0, losses: 0, pts_for: 0, pts_against: 0 } }
  - completed_matches.each do |match|
    - next unless standings.key?(match.pair1_id) && standings.key?(match.pair2_id)
    - if match.match_sets.any?
      - p1_pts = match.match_sets.sum(&:pair1_score)
      - p2_pts = match.match_sets.sum(&:pair2_score)
    - else
      - p1_pts = match.pair1_score.to_i
      - p2_pts = match.pair2_score.to_i
    - standings[match.pair1_id][:pts_for] += p1_pts
    - standings[match.pair1_id][:pts_against] += p2_pts
    - standings[match.pair2_id][:pts_for] += p2_pts
    - standings[match.pair2_id][:pts_against] += p1_pts
    - if match.winner_id == match.pair1_id
      - standings[match.pair1_id][:wins] += 1
      - standings[match.pair2_id][:losses] += 1
      - head_to_head[[match.pair1_id, match.pair2_id]] = match.pair1_id
      - head_to_head[[match.pair2_id, match.pair1_id]] = match.pair1_id
    - elsif match.winner_id == match.pair2_id
      - standings[match.pair2_id][:wins] += 1
      - standings[match.pair1_id][:losses] += 1
      - head_to_head[[match.pair2_id, match.pair1_id]] = match.pair2_id
      - head_to_head[[match.pair1_id, match.pair2_id]] = match.pair2_id
  - sorted_standings = standings.values.sort do |a, b|
    - net_a = a[:pts_for] - a[:pts_against]
    - net_b = b[:pts_for] - b[:pts_against]
    - h2h = head_to_head[[a[:pair].id, b[:pair].id]]
    - h2h_cmp = h2h == a[:pair].id ? -1 : (h2h == b[:pair].id ? 1 : 0)
    - if tournament.by_wins?
      - a[:wins] != b[:wins] ? b[:wins] <=> a[:wins] : (net_a != net_b ? net_b <=> net_a : h2h_cmp)
    - else
      - net_a != net_b ? net_b <=> net_a : h2h_cmp

  h4.mt-4.mb-3 Таблица результатов
  .table-responsive
    table.table.table-hover.table-sm.mb-4
      thead.table-light
        tr
          th #
          th Пара
          th.text-center = tournament.by_wins? ? "В ↓" : "В"
          th.text-center П
          th.text-center.text-success Очки +
          th.text-center.text-danger Очки -
          th.text-center = tournament.by_wins? ? "Разница" : "Разница ↓"
      tbody
        - sorted_standings.each_with_index do |stat, idx|
          tr
            td= idx + 1
            td= stat[:pair].player1.full_name + " / " + stat[:pair].player2.full_name
            td.text-center= stat[:wins]
            td.text-center= stat[:losses]
            td.text-center.text-success= stat[:pts_for]
            td.text-center.text-danger= stat[:pts_against]
            - net = stat[:pts_for] - stat[:pts_against]
            td.text-center class=(net > 0 ? "text-success fw-semibold" : (net < 0 ? "text-danger" : ""))
              = net >= 0 ? "+#{net}" : net.to_s

.d-flex.justify-content-between.align-items-center.mt-4.mb-3
  h4.mb-0 Расписание
  - if is_owner && !tournament.completed?
    .d-flex.gap-2
      - unless any_completed
        = button_to "Переставить пары", auto_assign_pairs_tournament_path(tournament), method: :post, class: "btn btn-outline-secondary btn-sm"
      - if tournament.active?
        - all_done = tournament.all_matches_completed?
        = link_to "Завершить турнир", fill_results_tournament_path(tournament), class: "btn btn-success btn-sm#{' disabled' unless all_done}", aria: { disabled: (true unless all_done) }, tabindex: (all_done ? nil : "-1")

/ Pair assignment forms rendered outside table (HTML5 form attribute association)
- if is_owner
  - matches.select { |m| m.pending? }.each do |match|
    = form_with url: assign_pairs_tournament_match_path(tournament, match), method: :patch, id: "pairs-form-#{match.id}", data: {turbo: false} do
      / empty

- rounds = matches.group_by(&:round_number).sort_by { |r, _| r }
- rounds.each do |round_number, round_matches|
  h6.mt-3.mb-2= "Раунд #{round_number}"
  table.table.table-hover.table-sm.mb-4
    thead.table-light
      tr
        th Пара 1
        th.text-center Счёт
        th Пара 2
        th.text-center Статус
        th
    tbody
      - round_matches.each do |match|
        - next unless match.pair1.present? || match.pair2.present? || is_owner
        tr
          td
            - if is_owner && match.pending?
              select.form-select.form-select-sm form="pairs-form-#{match.id}" name="match[pair1_id]" onchange="document.getElementById('pairs-form-#{match.id}').requestSubmit()"
                option value="" selected=(match.pair1_id.nil?) — …
                - pairs_options.each do |label, id|
                  option value=id selected=(match.pair1_id == id) = label
            - else
              = match.pair_display_name(match.pair1)
          td.text-center
            - if match.completed?
              - rr_sets = match.match_sets
              - if rr_sets.any?
                .d-flex.justify-content-center.gap-1.flex-wrap
                  - rr_sets.each do |set|
                    span.badge.bg-secondary= "#{set.pair1_score}:#{set.pair2_score}"
              - else
                strong= "#{match.pair1_score} : #{match.pair2_score}"
            - else
              span.text-muted —
          td
            - if is_owner && match.pending?
              select.form-select.form-select-sm form="pairs-form-#{match.id}" name="match[pair2_id]" onchange="document.getElementById('pairs-form-#{match.id}').requestSubmit()"
                option value="" selected=(match.pair2_id.nil?) — …
                - pairs_options.each do |label, id|
                  option value=id selected=(match.pair2_id == id) = label
            - else
              = match.pair_display_name(match.pair2)
          td.text-center
            - if match.completed?
              span.badge.bg-success Завершён
            - else
              span.badge.bg-secondary Не сыгран
          td
            .d-flex.align-items-center.gap-1
              - if is_owner && !match.bye? && match.pair1.present? && match.pair2.present?
                - btn_label = match.completed? ? "Изменить" : "Ввести результат"
                button.btn.btn-outline-primary.btn-sm data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}"
                  = btn_label
              - if match.completed? && match.pair1.present? && match.pair2.present?
                = link_to result_card_tournament_match_path(tournament, match), target: "_blank", class: "btn btn-outline-secondary btn-sm" do
                  i.bi.bi-image
