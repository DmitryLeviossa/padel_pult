doctype html
html lang="ru"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    title= "Результат — #{@match.tournament.name}"
    link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    css:
      body {
        background: #0d0d1a;
        color: #fff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
      }
      .card-wrap {
        background: #1a1a2e;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 40px 32px;
        max-width: 900px;
        width: 100%;
        box-shadow: 0 8px 48px rgba(0,0,0,0.5);
      }
      .tournament-title {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 4px;
      }
      .round-label {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.3);
        margin-bottom: 32px;
      }
      .match-layout {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
      }
      .pair-side {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        min-width: 0;
      }
      .pair-photo {
        width: 180px;
        height: 180px;
        border-radius: 16px;
        object-fit: cover;
        border: 3px solid rgba(255,255,255,0.1);
      }
      .pair-photo-placeholder {
        width: 180px;
        height: 180px;
        border-radius: 16px;
        background: rgba(255,255,255,0.06);
        border: 3px solid rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 12px;
      }
      .player-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255,255,255,0.15);
      }
      .player-avatar-initials {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: 2px solid rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        color: rgba(255,255,255,0.6);
      }
      .pair-name {
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        line-height: 1.5;
        color: #fff;
      }
      .winner-badge {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4dd991;
        background: rgba(25,135,84,0.15);
        border: 1px solid rgba(25,135,84,0.3);
        border-radius: 20px;
        padding: 3px 10px;
      }
      .score-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }
      .score-main {
        font-size: 4.5rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -2px;
      }
      .score-sep {
        color: rgba(255,255,255,0.25);
        margin: 0 6px;
      }
      .score-sets {
        display: flex;
        gap: 6px;
      }
      .score-set-chip {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.5);
        background: rgba(255,255,255,0.06);
        border-radius: 8px;
        padding: 2px 8px;
      }
      .winner-side .pair-photo,
      .winner-side .pair-photo-placeholder {
        border-color: rgba(25,135,84,0.5);
        box-shadow: 0 0 24px rgba(25,135,84,0.2);
      }
      .winner-side .pair-name { color: #4dd991; }
      .loser-side .pair-photo,
      .loser-side .pair-photo-placeholder { opacity: 0.5; }
      .loser-side .pair-name { color: rgba(255,255,255,0.4); }
      @media (max-width: 600px) {
        .match-layout { flex-direction: column; gap: 16px; }
        .pair-photo, .pair-photo-placeholder { width: 120px; height: 120px; }
        .score-main { font-size: 3rem; }
        .player-avatar, .player-avatar-initials { width: 50px; height: 50px; font-size: 14px; }
      }
  body
    - tournament = @match.tournament
    - pair1 = @pair1
    - pair2 = @pair2
    - winner_id = @match.winner_id
    - p1_wins = winner_id.present? && winner_id == @match.pair1_id
    - p1_loses = winner_id.present? && winner_id != @match.pair1_id
    - p2_wins = winner_id.present? && winner_id == @match.pair2_id
    - p2_loses = winner_id.present? && winner_id != @match.pair2_id
    - total_bracket_rounds = tournament.matches.where(stage: :bracket).maximum(:round_number).to_i
    - round_num = @match.round_number.to_i
    - if @match.group_stage?
      - round_label = "Групповой этап"
    - elsif @match.loser_bracket?
      - round_label = "Утешительная сетка — Раунд #{round_num}"
    - elsif round_num == total_bracket_rounds
      - round_label = "Финал"
    - elsif round_num == total_bracket_rounds - 1 && total_bracket_rounds > 2
      - round_label = "Полуфинал"
    - else
      - round_label = "Раунд #{round_num}"

    .card-wrap
      .text-center
        .tournament-title= tournament.name
        .round-label= round_label

      .match-layout
        .pair-side class=(p1_wins ? "winner-side" : (p1_loses ? "loser-side" : ""))
          - if pair1.nil?
            .pair-photo-placeholder
              i.bi.bi-people style="font-size:40px;opacity:0.3;"
          - elsif pair1.photo.attached?
            = image_tag pair1.photo.variant(resize_to_fill: [360, 360]), class: "pair-photo", alt: @match.pair_display_name(pair1)
          - else
            .pair-photo-placeholder
              - [pair1.player1, pair1.player2].each do |player|
                - user = player.user
                - initials = user.full_name.split.map(&:first).first(2).join.upcase
                - if user.photo.attached?
                  = image_tag user.photo.variant(resize_to_fill: [144, 144]), class: "player-avatar", alt: user.full_name
                - else
                  .player-avatar-initials= initials
          - if pair1
            .pair-name
              = pair1.player1.full_name
              br
              = pair1.player2.full_name
          - if p1_wins
            span.winner-badge Победитель

        .score-center
          .score-main
            span(class=(p1_wins ? "text-success" : ""))= @match.pair1_score.to_i
            span.score-sep = " : "
            span(class=(p2_wins ? "text-success" : ""))= @match.pair2_score.to_i
          - if @match_sets.any?
            .score-sets
              - @match_sets.each do |set|
                span.score-set-chip= "#{set.pair1_score}:#{set.pair2_score}"

        .pair-side class=(p2_wins ? "winner-side" : (p2_loses ? "loser-side" : ""))
          - if pair2.nil?
            .pair-photo-placeholder
              i.bi.bi-people style="font-size:40px;opacity:0.3;"
          - elsif pair2.photo.attached?
            = image_tag pair2.photo.variant(resize_to_fill: [360, 360]), class: "pair-photo", alt: @match.pair_display_name(pair2)
          - else
            .pair-photo-placeholder
              - [pair2.player1, pair2.player2].each do |player|
                - user = player.user
                - initials = user.full_name.split.map(&:first).first(2).join.upcase
                - if user.photo.attached?
                  = image_tag user.photo.variant(resize_to_fill: [144, 144]), class: "player-avatar", alt: user.full_name
                - else
                  .player-avatar-initials= initials
          - if pair2
            .pair-name
              = pair2.player1.full_name
              br
              = pair2.player2.full_name
          - if p2_wins
            span.winner-badge Победитель
