doctype html
html lang="ru"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    title= "Результат — #{@match.tournament.name}"
    css:
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #060c1a;
        color: #fff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .result-card {
        width: 960px;
        max-width: 100%;
        min-height: 420px;
        background: #0c1326;
        border-radius: 20px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 340px 1fr 340px;
        position: relative;
        box-shadow: 0 24px 80px rgba(0,0,0,0.7);
      }
      .result-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          -55deg,
          transparent,
          transparent 18px,
          rgba(255,255,255,0.012) 18px,
          rgba(255,255,255,0.012) 19px
        );
        pointer-events: none;
        z-index: 0;
      }

      /* ── Side panels ── */
      .team-panel {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
      }
      .team-panel-left  { background: linear-gradient(140deg, #0d2244 0%, #0c1326 100%); border-right: 1px solid rgba(255,255,255,0.07); }
      .team-panel-right { background: linear-gradient(220deg, #0d2244 0%, #0c1326 100%); border-left:  1px solid rgba(255,255,255,0.07); }

      .photo-area {
        position: absolute;
        top: 0; left: 0; right: 0;
        bottom: 100px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        overflow: hidden;
      }
      .photo-area img.pair-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
      }
      .photo-area .players-row {
        display: flex;
        gap: 8px;
        width: 100%;
        height: 100%;
        padding: 20px 16px 0;
        align-items: flex-end;
      }
      .player-thumb {
        flex: 1;
        min-height: 0;
        height: 170px;
        border-radius: 10px;
        object-fit: cover;
        object-position: top;
      }
      .player-initials-box {
        flex: 1;
        height: 170px;
        border-radius: 10px;
        background: rgba(255,255,255,0.07);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
        color: rgba(255,255,255,0.35);
      }

      /* Bottom gradient fading photo into info */
      .team-panel::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 180px;
        background: linear-gradient(to top, #0c1326 45%, transparent 100%);
        z-index: 2;
        pointer-events: none;
      }
      .team-info {
        position: relative;
        z-index: 3;
        padding: 0 20px 24px;
      }
      .team-panel-right .team-info { text-align: right; }

      .team-names {
        font-size: 1.3rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        line-height: 1.25;
        color: #fff;
        margin-bottom: 4px;
      }
      .team-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(255,255,255,0.3);
      }
      .team-panel.winner .team-names { color: #4dd991; }
      .team-panel.loser  .team-names { color: rgba(255,255,255,0.3); }

      /* ── Center panel ── */
      .center-panel {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 28px 20px 32px;
        background: #101929;
      }

      .tournament-name {
        font-size: 1.15rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #fff;
        text-align: center;
        line-height: 1.15;
        margin-bottom: 4px;
      }
      .tournament-dates {
        font-size: 0.68rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-align: center;
        margin-bottom: 4px;
      }
      .tournament-club {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: 0.68rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-align: center;
        margin-bottom: 4px;
      }
      .club-logo {
        width: 16px;
        height: 16px;
        object-fit: contain;
        border-radius: 3px;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5));
      }
      .round-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(255,255,255,0.3);
        text-align: center;
        margin-bottom: 22px;
      }

      .match-heading {
        font-size: 1.55rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-align: center;
        color: #fff;
        margin-bottom: 6px;
      }
      .teal-bar {
        width: 65%;
        height: 2px;
        background: linear-gradient(90deg, transparent, #26c6da 30%, #26c6da 70%, transparent);
        margin: 0 auto 20px;
      }

      /* Per-set score blocks */
      .set-block {
        width: 100%;
        text-align: center;
        margin-bottom: 14px;
      }
      .set-block + .set-block {
        border-top: 1px solid rgba(255,255,255,0.07);
        padding-top: 14px;
      }
      .set-name {
        font-size: 0.63rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: #26c6da;
        margin-bottom: 4px;
      }
      .set-score {
        font-size: 3.6rem;
        font-weight: 900;
        letter-spacing: -3px;
        line-height: 1;
        color: #fff;
      }
      .set-score .dash {
        font-size: 2.2rem;
        letter-spacing: 0;
        color: rgba(255,255,255,0.2);
        margin: 0 6px;
      }
      .w1 { color: #4dd991; }
      .w2 { color: #4dd991; }

      /* Fallback: overall score when no sets */
      .overall-score {
        font-size: 4.5rem;
        font-weight: 900;
        letter-spacing: -4px;
        line-height: 1;
        color: #fff;
        text-align: center;
      }
      .overall-score .dash {
        font-size: 2.8rem;
        letter-spacing: 0;
        color: rgba(255,255,255,0.2);
        margin: 0 10px;
      }

      .league-logo {
        max-width: 120px;
        max-height: 80px;
        width: auto;
        height: auto;
        object-fit: contain;
        margin-bottom: 10px;
        filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
      }
      .powered-by {
        margin-top: 22px;
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: rgba(255,255,255,0.18);
        text-align: center;
      }
      .powered-by span {
        color: rgba(38,198,218,0.55);
      }
      @media (max-width: 700px) {
        .result-card { grid-template-columns: 1fr; min-height: unset; }
        .center-panel { order: -1; border-bottom: 1px solid rgba(255,255,255,0.07); }
        .team-panel { min-height: 220px; }
        .photo-area { bottom: 80px; }
        .team-panel::after { height: 120px; }
        .set-score { font-size: 2.5rem; }
      }
      .download-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: rgba(255,255,255,0.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 0.05em;
        backdrop-filter: blur(8px);
        transition: background 0.2s;
      }
      .download-btn:hover { background: rgba(255,255,255,0.22); color: #fff; }
  body
    - if @match.result_card_image.attached? && params[:source].blank?
      = image_tag rails_blob_url(@match.result_card_image), alt: "Результат матча", style: "max-width:960px;width:100%;border-radius:20px;display:block;box-shadow:0 24px 80px rgba(0,0,0,0.7);"
    - else
      - tournament = @match.tournament
      - pair1 = @pair1
      - pair2 = @pair2
      - winner_id = @match.winner_id
      - p1_wins = winner_id.present? && winner_id == @match.pair1_id
      - p2_wins = winner_id.present? && winner_id == @match.pair2_id
      - p1_loses = winner_id.present? && !p1_wins
      - p2_loses = winner_id.present? && !p2_wins
      - total_bracket_rounds = @match.bracket.matches.maximum(:round_number).to_i
      - round_num = @match.round_number.to_i
      - if @match.group_stage?
        - round_label = "Групповой этап"
      - elsif @match.loser_bracket?
        - round_label = "Доп. турнир · Раунд #{round_num}"
      - elsif round_num == total_bracket_rounds
        - round_label = "Финал"
      - elsif round_num == total_bracket_rounds - 1 && total_bracket_rounds > 2
        - round_label = "Полуфинал"
      - else
        - round_label = "Раунд #{round_num}"
      - set_name_map = %w[ПЕРВЫЙ ВТОРОЙ ТРЕТИЙ ЧЕТВЁРТЫЙ ПЯТЫЙ]

      .result-card
        / ── Left: Team 1 ──
        .team-panel.team-panel-left class=((p1_wins ? "winner" : (p1_loses ? "loser" : "")))
          .photo-area
            - if pair1.nil?
              .players-row
                .player-initials-box ?
                .player-initials-box ?
            - elsif pair1.photo.attached?
              = image_tag pair1.photo.variant(resize_to_fill: [540, 400]), class: "pair-photo", alt: ""
            - elsif pair1.player1.user.photo.attached? || pair1.player2.user.photo.attached?
              .players-row
                - [pair1.player1, pair1.player2].each do |player|
                  - user = player.user
                  - if user.photo.attached?
                    = image_tag user.photo.variant(resize_to_fill: [200, 340]), class: "player-thumb", alt: ""
                  - else
                    = image_tag "/default_user_photo.svg", class: "player-thumb", alt: ""
            - else
              = image_tag "/default_pair_photo.svg", class: "pair-photo", alt: ""
          .team-info
            - if pair1
              .team-names
                - u1 = pair1.player1.user
                = "#{u1.first_name.present? ? u1.first_name[0] + '. ' : ''}#{u1.last_name}"
                br
                - u2 = pair1.player2.user
                = "#{u2.first_name.present? ? u2.first_name[0] + '. ' : ''}#{u2.last_name}"

        / ── Center ──
        .center-panel
          - league = tournament.league
          - if league.logo.attached?
            = image_tag league.logo.variant(resize_to_limit: [120, 80]), class: "league-logo", alt: league.name
          .tournament-name= tournament.name
          .tournament-dates= tournament_date_range(tournament)
          - if tournament.club
            .tournament-club
              - if tournament.club.logo.attached?
                = image_tag tournament.club.logo.variant(resize_to_fill: [32, 32]), class: "club-logo", alt: ""
              = tournament.club.name
          .round-label= round_label
          .match-heading Итоги матча
          .teal-bar
          - if @match_sets.any?
            - @match_sets.each_with_index do |set, i|
              - s1_wins = set.pair1_score.to_i > set.pair2_score.to_i
              - s2_wins = set.pair2_score.to_i > set.pair1_score.to_i
              .set-block
                .set-name= "#{set_name_map[i] || "Сет #{i+1}"} сет"
                .set-score
                  span(class=(s1_wins ? "w1" : ""))= set.pair1_score.to_i
                  span.dash —
                  span(class=(s2_wins ? "w2" : ""))= set.pair2_score.to_i
          - else
            .overall-score
              span(class=(p1_wins ? "w1" : ""))= @match.pair1_score.to_i
              span.dash —
              span(class=(p2_wins ? "w2" : ""))= @match.pair2_score.to_i
          .powered-by
            | Создано в&nbsp;
            span Падел Пульт

        / ── Right: Team 2 ──
        .team-panel.team-panel-right class=((p2_wins ? "winner" : (p2_loses ? "loser" : "")))
          .photo-area
            - if pair2.nil?
              .players-row
                .player-initials-box ?
                .player-initials-box ?
            - elsif pair2.photo.attached?
              = image_tag pair2.photo.variant(resize_to_fill: [540, 400]), class: "pair-photo", alt: ""
            - elsif pair2.player1.user.photo.attached? || pair2.player2.user.photo.attached?
              .players-row
                - [pair2.player1, pair2.player2].each do |player|
                  - user = player.user
                  - if user.photo.attached?
                    = image_tag user.photo.variant(resize_to_fill: [200, 340]), class: "player-thumb", alt: ""
                  - else
                    = image_tag "/default_user_photo.svg", class: "player-thumb", alt: ""
            - else
              = image_tag "/default_pair_photo.svg", class: "pair-photo", alt: ""
          .team-info
            - if pair2
              .team-names
                - u3 = pair2.player1.user
                = "#{u3.first_name.present? ? u3.first_name[0] + '. ' : ''}#{u3.last_name}"
                br
                - u4 = pair2.player2.user
                = "#{u4.first_name.present? ? u4.first_name[0] + '. ' : ''}#{u4.last_name}"
    - if @match.result_card_image.attached?
      = link_to rails_blob_url(@match.result_card_image, disposition: :attachment), class: "download-btn" do
        | ↓ Скачать картинку
