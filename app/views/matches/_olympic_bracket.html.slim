- total_rounds = bracket_rounds.length
- pairs_options = tournament.pairs.map { |p| [p.player1.short_name + " / " + p.player2.short_name, p.id] }

.d-flex.justify-content-between.align-items-center.mt-4.mb-3
  h4.mb-0 Основной турнир
  - if is_owner && !tournament.completed?
    .d-flex.gap-2
      - unless any_completed
        = button_to "Переставить пары", auto_assign_pairs_tournament_path(tournament), method: :post, class: "btn btn-outline-secondary btn-sm"
      - if tournament.active?
        - all_done = tournament.all_matches_completed?
        = link_to "Завершить турнир", fill_results_tournament_path(tournament), class: "btn btn-success btn-sm#{' disabled' unless all_done}", aria: { disabled: (true unless all_done) }, tabindex: (all_done ? nil : "-1")

css:
  .tournament-bracket {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    padding-bottom: 8px;
    justify-content: center;
  }
  .bracket-round {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    padding: 0 8px;
    position: relative;
  }
  @media (min-width: 576px) {
    .bracket-round {
      min-width: 280px;
      padding: 0 16px;
    }
  }
  .bracket-round:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 5%;
    height: 90%;
    border-right: 2px dashed var(--bs-border-color);
  }
  .bracket-round-header {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--bs-secondary-color);
    margin-bottom: 8px;
    flex-shrink: 0;
  }
  .bracket-match-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 80px;
  }
  .bracket-match {
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bs-secondary-bg);
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }
  .bracket-team {
    padding: 8px 12px;
    font-size: 13px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--bs-border-color);
    min-height: 38px;
    color: var(--bs-body-color);
    gap: 8px;
  }
  .bracket-team:last-child {
    border-bottom: none;
  }
  .bracket-team.winner {
    font-weight: 700;
    background-color: rgba(25, 135, 84, 0.2);
    color: var(--bs-success);
  }
  .bracket-team.loser {
    color: var(--bs-secondary-color);
  }
  .bracket-team.bye-slot {
    color: var(--bs-tertiary-color);
    font-style: italic;
  }
  .bracket-team.empty-slot {
    color: var(--bs-tertiary-color);
    font-style: italic;
  }
  .bracket-name {
    flex: 1;
    word-break: break-word;
    min-width: 0;
  }
  .bracket-score {
    font-size: 13px;
    font-weight: 700;
    min-width: 20px;
    text-align: right;
    flex-shrink: 0;
  }
  .bracket-team.winner .bracket-score { color: var(--bs-success); }
  .bracket-team.loser  .bracket-score { color: var(--bs-secondary-color); }
  .bracket-enter-btn {
    font-size: 11px;
    padding: 2px 8px;
    margin-top: 5px;
    align-self: flex-end;
  }
  .bracket-pair-select {
    flex: 1;
    font-size: 11px;
    padding: 2px 4px;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    border-radius: 4px;
    min-width: 0;
  }

.tournament-bracket
  - bracket_rounds.each_with_index do |round_matches, idx|
    - round_num = idx + 1
    - round_label = round_num == total_rounds ? "Финал" : round_num == total_rounds - 1 && total_rounds > 2 ? "Полуфинал" : "Раунд #{round_num}"
    .bracket-round
      .bracket-round-header= round_label
      - slot_height = 116 * (2 ** idx)
      - round_matches.each do |match|
        .bracket-match-wrapper style="min-height: #{slot_height}px;"
          - can_edit_pairs = is_owner && !match.completed? && !match.bye? && match.round_number == 1
          - can_enter_result = is_owner && !match.bye? && match.pair1.present? && match.pair2.present? && !match.has_downstream_results? && !tournament.completed?
          - if can_edit_pairs
            = form_with url: assign_pairs_tournament_match_path(tournament, match), method: :patch, id: "pairs-form-#{match.id}", data: {turbo: false} do
              / empty form shell for attribute association
          .bracket-match
            - sets = match.match_sets
            - [[match.pair1, match.pair1_score, match.pair1_id, :pair1_id, 0], [match.pair2, match.pair2_score, match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
              - is_winner = match.winner_id.present? && match.winner_id == pair_id
              - is_loser  = match.winner_id.present? && pair_id.present? && match.winner_id != pair_id
              - css_class = pair.nil? ? (match.bye? ? "bye-slot" : "empty-slot") : (is_winner ? "winner" : (is_loser ? "loser" : ""))
              .bracket-team class=css_class
                - if can_edit_pairs
                  select.bracket-pair-select form="pairs-form-#{match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{match.id}').requestSubmit()"
                    option value="" selected=(pair_id.nil?) — …
                    - pairs_options.each do |label, id|
                      option value=id selected=(pair_id == id) = label
                - else
                  span.bracket-name= pair ? match.pair_display_name(pair) : (match.bye? ? "Свободен" : "…")
                - if sets.any?
                  .d-flex.gap-2
                    - sets.each do |set|
                      span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
                - elsif score.present?
                  span.bracket-score= score
          - if can_enter_result
            - btn_label = match.completed? ? "Изменить результат" : "Ввести результат"
            button.btn.btn-outline-primary.btn-sm.bracket-enter-btn(data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}")
              = btn_label
          - if is_owner && !match.completed? && !match.bye? && !(match.pair1.present? && match.pair2.present?)
            = link_to "Завершить матч", finish_tournament_match_path(tournament, match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn"
          - if match.completed? && match.pair1.present? && match.pair2.present?
            = link_to result_card_tournament_match_path(tournament, match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn" do
              i.bi.bi-image

- if third_place_match
  .mt-4.d-flex.flex-column.align-items-center
    .bracket-round-header.mb-2 Матч за 3-е место
    .d-flex.flex-column style="min-width: 240px; max-width: 360px;"
      - can_edit_tp_pairs = is_owner && !third_place_match.completed? && !third_place_match.bye?
      - if can_edit_tp_pairs
        = form_with url: assign_pairs_tournament_match_path(tournament, third_place_match), method: :patch, id: "pairs-form-#{third_place_match.id}", data: {turbo: false} do
          / empty
      .bracket-match
        - tp_sets = third_place_match.match_sets
        - [[third_place_match.pair1, third_place_match.pair1_score, third_place_match.pair1_id, :pair1_id, 0], [third_place_match.pair2, third_place_match.pair2_score, third_place_match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
          - is_winner = third_place_match.winner_id.present? && third_place_match.winner_id == pair_id
          - is_loser  = third_place_match.winner_id.present? && pair_id.present? && third_place_match.winner_id != pair_id
          - css_class = pair.nil? ? "empty-slot" : (is_winner ? "winner" : (is_loser ? "loser" : ""))
          .bracket-team class=css_class
            - if can_edit_tp_pairs
              select.bracket-pair-select form="pairs-form-#{third_place_match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{third_place_match.id}').requestSubmit()"
                option value="" selected=(pair_id.nil?) — …
                - pairs_options.each do |label, id|
                  option value=id selected=(pair_id == id) = label
            - else
              span.bracket-name= pair ? third_place_match.pair_display_name(pair) : "…"
            - if tp_sets.any?
              .d-flex.gap-2
                - tp_sets.each do |set|
                  span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
            - elsif score.present?
              span.bracket-score= score
      - if is_owner && !tournament.completed? && !third_place_match.bye? && third_place_match.pair1.present? && third_place_match.pair2.present? && !third_place_match.has_downstream_results?
        - tp_btn_label = third_place_match.completed? ? "Изменить результат" : "Ввести результат"
        button.btn.btn-outline-primary.btn-sm.bracket-enter-btn.mt-1(data-bs-toggle="modal" data-bs-target="#match-modal-#{third_place_match.id}")
          = tp_btn_label
      - if is_owner && !third_place_match.completed? && !third_place_match.bye? && !(third_place_match.pair1.present? && third_place_match.pair2.present?)
        = link_to "Завершить матч", finish_tournament_match_path(tournament, third_place_match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn mt-1"
      - if third_place_match.completed? && third_place_match.pair1.present? && third_place_match.pair2.present?
        = link_to result_card_tournament_match_path(tournament, third_place_match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn mt-1" do
          i.bi.bi-image

- if loser_bracket_rounds&.any?
  h4.mt-5.mb-3 Доп. турнир

  - lb_total_rounds = loser_bracket_rounds.length
  .tournament-bracket
    - loser_bracket_rounds.each_with_index do |round_matches, idx|
      - round_num = idx + 1
      - round_label = round_num == lb_total_rounds ? "Финал" : "Раунд #{round_num}"
      .bracket-round
        .bracket-round-header= round_label
        - lb_slot_height = 116 * (2 ** idx)
        - round_matches.each do |match|
          .bracket-match-wrapper style="min-height: #{lb_slot_height}px;"
            - can_edit_pairs = is_owner && !match.completed? && !match.bye? && match.round_number == 1
            - can_enter_result = is_owner && !match.bye? && match.pair1.present? && match.pair2.present? && !match.has_downstream_results? && !tournament.completed?
            - if can_edit_pairs
              = form_with url: assign_pairs_tournament_match_path(tournament, match), method: :patch, id: "pairs-form-#{match.id}", data: {turbo: false} do
                / empty
            .bracket-match
              - sets = match.match_sets
              - [[match.pair1, match.pair1_score, match.pair1_id, :pair1_id, 0], [match.pair2, match.pair2_score, match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
                - is_winner = match.winner_id.present? && match.winner_id == pair_id
                - is_loser  = match.winner_id.present? && pair_id.present? && match.winner_id != pair_id
                - css_class = pair.nil? ? "empty-slot" : (is_winner ? "winner" : (is_loser ? "loser" : ""))
                .bracket-team class=css_class
                  - if can_edit_pairs
                    select.bracket-pair-select form="pairs-form-#{match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{match.id}').requestSubmit()"
                      option value="" selected=(pair_id.nil?) — …
                      - pairs_options.each do |label, id|
                        option value=id selected=(pair_id == id) = label
                  - else
                    span.bracket-name= pair ? match.pair_display_name(pair) : "…"
                  - if sets.any?
                    .d-flex.gap-2
                      - sets.each do |set|
                        span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
                  - elsif score.present?
                    span.bracket-score= score
            - if can_enter_result
              - btn_label = match.completed? ? "Изменить результат" : "Ввести результат"
              button.btn.btn-outline-primary.btn-sm.bracket-enter-btn(data-bs-toggle="modal" data-bs-target="#match-modal-#{match.id}")
                = btn_label
            - if is_owner && !match.completed? && !match.bye? && !(match.pair1.present? && match.pair2.present?)
              = link_to "Завершить матч", finish_tournament_match_path(tournament, match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn"
            - if match.completed? && match.pair1.present? && match.pair2.present?
              = link_to result_card_tournament_match_path(tournament, match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn" do
                i.bi.bi-image

  - if loser_third_place_match
    .mt-4.d-flex.flex-column.align-items-center
      .bracket-round-header.mb-2 Матч за 3-е место
      .d-flex.flex-column style="min-width: 240px; max-width: 360px;"
        - can_edit_ltp = is_owner && !loser_third_place_match.completed? && !loser_third_place_match.bye?
        - if can_edit_ltp
          = form_with url: assign_pairs_tournament_match_path(tournament, loser_third_place_match), method: :patch, id: "pairs-form-#{loser_third_place_match.id}", data: {turbo: false} do
            / empty
        .bracket-match
          - ltp_sets = loser_third_place_match.match_sets
          - [[loser_third_place_match.pair1, loser_third_place_match.pair1_score, loser_third_place_match.pair1_id, :pair1_id, 0], [loser_third_place_match.pair2, loser_third_place_match.pair2_score, loser_third_place_match.pair2_id, :pair2_id, 1]].each do |pair, score, pair_id, field_name, slot_idx|
            - is_winner = loser_third_place_match.winner_id.present? && loser_third_place_match.winner_id == pair_id
            - is_loser  = loser_third_place_match.winner_id.present? && pair_id.present? && loser_third_place_match.winner_id != pair_id
            - css_class = pair.nil? ? "empty-slot" : (is_winner ? "winner" : (is_loser ? "loser" : ""))
            .bracket-team class=css_class
              - if can_edit_ltp
                select.bracket-pair-select form="pairs-form-#{loser_third_place_match.id}" name="match[#{field_name}]" onchange="document.getElementById('pairs-form-#{loser_third_place_match.id}').requestSubmit()"
                  option value="" selected=(pair_id.nil?) — …
                  - pairs_options.each do |label, id|
                    option value=id selected=(pair_id == id) = label
              - else
                span.bracket-name= pair ? loser_third_place_match.pair_display_name(pair) : "…"
              - if ltp_sets.any?
                .d-flex.gap-2
                  - ltp_sets.each do |set|
                    span.bracket-score= slot_idx == 0 ? set.pair1_score : set.pair2_score
              - elsif score.present?
                span.bracket-score= score
        - if is_owner && !tournament.completed? && !loser_third_place_match.bye? && loser_third_place_match.pair1.present? && loser_third_place_match.pair2.present? && !loser_third_place_match.has_downstream_results?
          - ltp_btn_label = loser_third_place_match.completed? ? "Изменить результат" : "Ввести результат"
          button.btn.btn-outline-primary.btn-sm.bracket-enter-btn.mt-1(data-bs-toggle="modal" data-bs-target="#match-modal-#{loser_third_place_match.id}")
            = ltp_btn_label
        - if is_owner && !loser_third_place_match.completed? && !loser_third_place_match.bye? && !(loser_third_place_match.pair1.present? && loser_third_place_match.pair2.present?)
          = link_to "Завершить матч", finish_tournament_match_path(tournament, loser_third_place_match), data: { turbo_method: :post }, class: "btn btn-outline-warning btn-sm bracket-enter-btn mt-1"
        - if loser_third_place_match.completed? && loser_third_place_match.pair1.present? && loser_third_place_match.pair2.present?
          = link_to result_card_tournament_match_path(tournament, loser_third_place_match), target: "_blank", class: "btn btn-outline-secondary btn-sm bracket-enter-btn mt-1" do
            i.bi.bi-image
