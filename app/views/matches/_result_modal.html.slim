- matches.each do |match|
  - next if match.bye?
  - next if match.pair1.nil? || match.pair2.nil?
  - next if match.has_downstream_results?
  .modal.fade id="match-modal-#{match.id}" tabindex="-1"
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title= match.completed? ? "Изменить результат" : "Результат матча"
          button.btn-close type="button" data-bs-dismiss="modal"
        = form_with url: tournament_match_path(match.tournament, match), method: :patch, scope: :match do |f|
          .modal-body
            - if tournament.sets_per_match > 1
              - tournament.sets_per_match.times do |i|
                - existing_set = match.match_sets.find { |s| s.set_number == i + 1 }
                - set_record = existing_set || MatchSet.new(set_number: i + 1)
                = f.fields_for :match_sets_attributes, set_record, index: i do |sf|
                  = sf.hidden_field :set_number
                  p.fw-semibold.mb-1= "Сет #{i + 1}"
                  .row.g-2.mb-3
                    .col
                      label.form-label.small= match.pair_display_name(match.pair1)
                      = sf.number_field :pair1_score, class: "form-control", min: 0, required: true, placeholder: "0", value: existing_set&.pair1_score
                    .col
                      label.form-label.small= match.pair_display_name(match.pair2)
                      = sf.number_field :pair2_score, class: "form-control", min: 0, required: true, placeholder: "0", value: existing_set&.pair2_score
            - else
              .mb-3
                label.form-label.fw-semibold= match.pair_display_name(match.pair1)
                = f.number_field :pair1_score, class: "form-control", min: 0, required: true, placeholder: "0", value: match.pair1_score
              .mb-3
                label.form-label.fw-semibold= match.pair_display_name(match.pair2)
                = f.number_field :pair2_score, class: "form-control", min: 0, required: true, placeholder: "0", value: match.pair2_score

          .modal-footer
            button.btn.btn-secondary type="button" data-bs-dismiss="modal" Отмена
            = f.submit "Сохранить", class: "btn btn-primary"
