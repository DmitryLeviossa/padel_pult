= form_with model: [@league, season], html: { enctype: "multipart/form-data" } do |f|
  - if season.errors.any?
    .alert.alert-danger
      ul.mb-0
        - season.errors.full_messages.each do |msg|
          li= msg

  .mb-3
    = f.label :name, "Название", class: "form-label"
    = f.text_field :name, class: "form-control", required: true

  .mb-3
    = f.label :date_from, "Дата начала", class: "form-label"
    = f.date_field :date_from, class: "form-control", required: true

  .mb-3
    = f.label :date_to, "Дата окончания", class: "form-label"
    = f.date_field :date_to, class: "form-control", required: true

  .mb-3
    = f.label :logo, "Логотип сезона", class: "form-label"
    = f.file_field :logo, class: "form-control", accept: "image/*"
    - if season.logo.attached?
      .mt-2
        = image_tag season.logo, style: "height: 80px; object-fit: cover; border-radius: 4px;"

  .mb-3
    = f.label :description, "Описание", class: "form-label"
    = f.text_area :description, class: "form-control", rows: 3

  = f.submit season.new_record? ? "Создать" : "Сохранить", class: "btn btn-primary"
  = link_to "Отмена", league_path(@league, anchor: "seasons"), class: "btn btn-outline-secondary ms-2"
