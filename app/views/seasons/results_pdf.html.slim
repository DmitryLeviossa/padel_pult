.container.py-4
  .d-flex.align-items-center.gap-3.mb-4
    - if (logo = @season.effective_logo)
      = image_tag logo, class: "rounded", style: "width: 64px; height: 64px; object-fit: cover;"
    div
      h1.mb-1= @season.name
      p.mb-0.text-muted= "#{@league.name} · #{ru_date(@season.date_from)} — #{ru_date(@season.date_to)}"

  - if @season.description.present?
    p.text-muted.mt-3= @season.description

  h5.mt-4.mb-3 Турниры сезона

  - if @tournaments.any?
    table.table.table-hover
      thead
        tr
          th Название
          th Даты
          th Клуб
          th Тип
          th Статус
          th.text-end Участники
      tbody
        - @tournaments.each do |tournament|
          tr
            td= tournament.name
            td= tournament_date_range(tournament)
            td= tournament.club&.name || "—"
            td= { "olympic" => "Олимпийский", "round_robin" => "Круговой", "mixed" => "Смешанный" }.fetch(tournament.type, tournament.type)
            td
              - badge_class = { "draft" => "secondary", "registration" => "info", "active" => "success", "completed" => "primary", "cancelled" => "danger" }.fetch(tournament.status, "secondary")
              span.badge class="bg-#{badge_class}"
                = { "draft" => "Черновик", "registration" => "Регистрация", "active" => "Активный", "completed" => "Завершён", "cancelled" => "Отменён" }.fetch(tournament.status, tournament.status)
            td.text-end= "#{tournament.pairs.count * 2} / #{tournament.max_participants}"
  - else
    p.text-muted В этом сезоне турниров не запланировано.

  h5.mt-5.mb-3 Рейтинг участников

  - if @rankings.any?
    table.table.table-hover
      thead
        tr
          th #
          th Фото
          th Имя
          th.text-end Очки
      tbody
        - @rankings.each_with_index do |entry, index|
          - lu = entry[:league_user]
          tr
            td
              - cup = { 0 => "🥇", 1 => "🥈", 2 => "🥉" }[index]
              - if cup
                span style="font-size: 1.5rem; line-height: 1;"= cup
              - else
                = index + 1
            td
              = render "shared/avatar", user: lu.user
            td= lu.full_name
            td.text-end
              strong= entry[:points]
  - else
    p.text-muted Ни один участник ещё не заработал очков в турнирах этого сезона.

  .text-center.text-muted.mt-5.pt-3.border-top style="font-size: 0.8rem;"
    = "ПАДЕЛ Пульт · Сформировано #{ru_date(Date.current)}"
