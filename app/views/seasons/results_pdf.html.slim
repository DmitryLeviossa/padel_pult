.doc-header
  - if (logo = @season.effective_logo)
    = image_tag logo, class: "doc-logo"
  div
    h1.doc-title= @season.name
    p.doc-subtitle= "#{@league.name} · #{ru_date(@season.date_from)} — #{ru_date(@season.date_to)}"

- if @season.description.present?
  p.doc-description= @season.description

h2.section-title Турниры сезона

- if @tournaments.any?
  table.report-table
    thead
      tr
        th Название
        th Даты
        th Клуб
        th Тип
        th Статус
        th.text-end Участники
    tbody
      - @tournaments.each do |tournament|
        tr
          td= tournament.name
          td= tournament_date_range(tournament)
          td= tournament.club&.name || "—"
          td= { "olympic" => "Олимпийский", "round_robin" => "Круговой", "mixed" => "Смешанный" }.fetch(tournament.type, tournament.type)
          td
            - pill_class = { "draft" => "pill-draft", "registration" => "pill-registration", "active" => "pill-active", "completed" => "pill-completed", "cancelled" => "pill-cancelled" }.fetch(tournament.status, "pill-draft")
            span.pill class=pill_class
              = { "draft" => "Черновик", "registration" => "Регистрация", "active" => "Активный", "completed" => "Завершён", "cancelled" => "Отменён" }.fetch(tournament.status, tournament.status)
          td.text-end= "#{tournament.pairs.count * 2} / #{tournament.max_participants}"
- else
  p.empty-state В этом сезоне турниров не запланировано.

h2.section-title Рейтинг участников

- if @rankings.any?
  .leaderboard
    - @rankings.each_with_index do |entry, index|
      - lu = entry[:league_user]
      .rank-row class="#{index < 3 ? "top-#{index + 1}" : ""}"
        - medal = { 0 => "🥇", 1 => "🥈", 2 => "🥉" }[index]
        - if medal
          .rank-medal= medal
        - else
          .rank-num= index + 1
        .rank-name= lu.full_name
        .rank-points= entry[:points]
- else
  p.empty-state Ни один участник ещё не заработал очков в турнирах этого сезона.

.doc-footer
  = "ПАДЕЛ Пульт · Сформировано #{ru_date(Date.current)}"
